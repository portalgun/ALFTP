################################################################################
MAIN () {
    ARGV=("$@")
    # Re-entry from the in-session helper (see SINGLE_SESSION): argv arrives in
    # a NUL-delimited file so that nothing has to survive a round trip through
    # the user's $SHELL, and re-parsing it reproduces this session's globals
    # exactly -- they are all derived from the config plus argv.
    if [[ -n ${ALFTP_ARGV:-} ]]; then
        load_argv "$ALFTP_ARGV"
        set -- "${ARGV[@]}"
    fi
    resolve_self

    INIT
    ARGSA "$@" #PRIORITY FLAGS
    eval_local_config
    eval_remote_config
    ARGSB "$@" #CONFIG FLAGS
    ARGSC "$@" #OTHER FLAGS

    WELCOME
    if [[ -n ${ALFTP_EMIT_DL:-} ]]; then
        EMIT_DL
        return 0
    fi
    NEW_SESSION
    COMPLETE
}

load_argv () {
    ARGV=()
    mapfile -t -d '' ARGV < "$1"
}

# The "!" helper line has to name this script by an absolute path: lftp runs it
# through $SHELL from an unknown working directory.
resolve_self () {
    self=$(command -v -- "$0" 2>/dev/null) || self="$0"
    if [[ $self != /* ]]; then
        self="$PWD/${self#./}"
    fi
}
################################################################################
INIT () {
    if [[ ! -f $config ]]; then
        echo "Config doesn't exist."
        flag=""
        while true; do
            if [[ -z $flag ]]; then
                read -p "Create config at $config? [y/n]: " -n1 opt
            else
                read -n1 opt
            fi
            case $opt in
                y|Y)
                    if ! mkdir -p "$(dirname "$config")"; then
                        echo "Could not create $(dirname "$config")." >&2
                        exit 1
                    fi
                    printf '%s' "$config_template" > "$config"
                    break
                    ;;
                n|N)
                    break
            esac
            flag=1
        done
        flag=""
        echo "Fill in options in config file, then run again."
        exit 0
    fi
    source "$config"
    USER=$(whoami)
}

#flags that ignore others
ARGSA () {
    for i in "$@"; do
        case "$i" in
            -h|--help|help)
                printf '%s\n' "$help"
                exit 0
                ;;
            --showc|showc)
                printf '%s\n' "$copyright"
                exit 0
                ;;
            --showw|showw)
                printf '%s\n' "$warranty"
                exit 0
                ;;
        esac
    done
}

# Escape ERE metacharacters so hostnames/server names containing '.', '-' etc.
# match literally. Backslashes are doubled because awk -v processes escape
# sequences in the value it is handed.
ere_escape () {
    printf '%s' "$1" | sed 's/[][\.^$*+?(){}|]/\\\\&/g'
}

# A profile name becomes part of a variable name (dl_dir_<profile>), so map
# anything that is not valid in an identifier to '_': profile "tv-shows" is
# configured as dl_dir_tv_shows.
profile_var_name () {
    printf '%s' "${1//[^A-Za-z0-9_]/_}"
}

eval_local_config () {
    I=$(ere_escape "$(hostname)")'\\|*[A-Za-z0-9._]*\\]'
    local_config=$(awk -v awkvar="$I" 'BEGIN { RS="\n\n\\[" ; FS="\n"; OFS="\n"} $1 ~ awkvar {$1=""; print $0}' "$configsrc" | \
	grep -vE "^(port|user|dataDir|watchDir|completeDir|pass|srcs)" | \
	sed -e 's/^dl_dir=/local_dl_dir=/' -e 's/^dl_dir_/local_dl_dir_/' \
    )
    eval "$local_config"
}

eval_remote_config () {
    #I='srcs *=.*'"$i"

    def=$(grep -E '^[[:space:]]*default_server=' "$configsrc" | tail -n 1)
    if [[ -n $def ]]; then
        eval "$def"
    fi
    if [[ -n $default_server ]]; then
        I='\\|'"$(ere_escape "$default_server")"'\\]'
    fi
    #remote_config=$(awk -v awkvar="$I" 'BEGIN { RS="\n\n\\[" ; FS="\n"; OFS="\n"} $0 ~ awkvar {print $0}' "$configsrc" | \
    remote_config=$(awk -v awkvar="$I" 'BEGIN { RS="\n\n\\[" ; FS="\n"; OFS="\n"} $0 ~ awkvar {print $0}' "$configsrc" | \
	grep -vE "^srcs" | \
	sed 's/^dl_dir=/remote_dl_dir=/' | \
	sed '1 s/|\(.*\)]/name=\1/'
    )
    #echo "$remote_config"
    eval "$remote_config"

}

ARGSB () {
    for i in "$@"; do
        if [ ! -z "$nextParam" ]; then
            case "$i" in
                -*)
                    nextParam=""
                    #echo "Missing field for "$lastParam" or incorrect syntax for "$i""
                    #exit 0
                    ;;
            esac
            case "$nextParam" in
                [ia])
		    profilevar=$(profile_var_name "$i")

		    # dl_dir_<profile> (renamed to local_dl_dir_<profile> when the
		    # config is eval'd) beats the general dl_dir for this profile.
		    # @profile is still substituted afterwards, so the override may
		    # use it too.
		    override="local_dl_dir_$profilevar"
		    if [[ -n ${!override:-} ]]; then
			local_dl_dir="${!override}"
		    fi
		    local_dl_dir=$(echo "$local_dl_dir" | sed "s/@profile/$i/g")
                    destflag=1

		    # Picking a profile settles both ends: an explicit
		    # remote_dl_dir_<profile>, the profile's own remote_dl_dir, or
		    # the profile name if it has neither.
		    override="remote_dl_dir_$profilevar"
		    if [[ -n ${!override:-} ]]; then
			remote_dl_dir="${!override}"
		    fi
		    if [[ -z $remote_dl_dir ]]; then
			remote_dl_dir="$i"
		    fi
		    sourceflag=1

                    ;;
            esac
        fi
        case "$i" in
            -a)
                all_files=True
                nextParam="a"
                ;;
            -i)
                ind_files=True
                nextParam="i"
                ;;
        esac
    done
}

ARGSC () {
    nextParam=""
    for i in "$@"; do
        if [ ! -z "$nextParam" ]; then
            case "$i" in
                -*)
                    echo "Missing field for "$lastParam" or incorrect syntax for "$i""
                    exit 0
                    ;;
            esac
            case "$nextParam" in
                l)
                    listfile="$i"
                    ;;
                ld)
                    local_dl_dir="$i"
                    ;;
                p)
                    password="$i"
                    ;;
                P)
                    port="$i"
                    ;;
                rd)
                    remote_dl_dir="$i"
                    ;;
                s)
                    server="$i"
                    ;;
                u)
                    username="$i"
                    ;;
            esac
            nextParam=""
            lastParam=""
            continue
        fi

        case "$i" in
            -q)
                quiet=True
                ;;
            -u)
                lastParam="$i"
                nextParam="u"
                ;;
            -p)
                lastParam="$i"
                nextParam="p"
                ;;
            -P)
                lastParam="$i"
                nextParam="P"
                ;;
            -s)
                lastParam="$i"
                nextParam="s"
                ;;

            -ld)
                lastParam="$i"
                nextParam="ld"
                destflag=1
                ;;
            -rd)
                lastParam="$i"
                nextParam="rd"
                sourceflag=1
                ;;
            -l)
                lastParam="$i"
                nextParam="l"
                ;;
            -n)
                new_only=True
                ;;
            -ns)
                suspend_old=True
                new_only=True
                ;;
            -o)
                old_only=True
                ;;
            -fs)
                print_fs=True
                ;;
            -jl)
                just_login=True
                return 0
                ;;
            -rl)
                rm_list=True
                ;;
            -rm)
                rm_remote=True
                ;;
            -r)
                no_append=True
                ;;
            -cl)
                clean=True
                ;;
            -d)
                data=True
                ;;
            -do)
                norm=True
                ;;
            -nu)
                nounrar=True
                ;;
            -dr|--dry-run)
                dry_run=True
                ;;
            -ds|--dir-sizes)
                dir_sizes=True
                ;;
            -t|--tui)
                picker=tui
                ;;
            -e|--editor)
                picker=editor
                ;;
            --two-session)
                two_session=True
                ;;
        esac
    done
    if [[ -z $destflag ]]; then
        echo "Please specify desitnation."
        exit 0
    fi
    if [[ -z $sourceflag ]]; then
        echo "Please specify source."
        exit 0
    fi
    dirname="$remote_dl_dir"

    if [[ -z $complete_dir ]] && [[ ! -z $data_dir ]]; then
        data=True
    fi
    if [[ ${data,,} == true ]]; then
        remote_dl_dir="$data_dir""$remote_dl_dir"
    else
        remote_dl_dir="$complete_dir""$remote_dl_dir"
    fi

    if [[ ! -z $keyfile ]]; then
          set sftp:connect-program "ssh -a -x -i $keyfile"
    fi
}
