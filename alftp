#DOWNLOAD DIRECTORIES
DLDR () {
    while read -r line; do
        #line=$(echo "$line" | sed 's|SsS$| |') # handle trailing whitespace and brackets
        #echo echo "\"$line\""
        line=$(echo "$line" | sed 's|SsS$| |' | sed 's/\[/"\["/g') # handle trailing whitespace and brackets
        #line=$(echo "$line" | sed 's|[ \t]*$| |' | sed 's/\[/"\["/g') # handle trailing whitespace and brackets
        #echo echo "\"$line\""
        if [[ -z $line ]]; then
            continue
        fi
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "mirror -c -P5 --dry-run \"$line\" "$local_dl_dir"/"\"$line\""; !echo DRY-RUN: \"$line\""
        elif [[ $norm == True ]]; then
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" "$local_dl_dir"/"\"$line\""; !echo COMPLETE: \"$line\""
        else
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" "$local_dl_dir"/"\"$line\"" && rm -f \"$line\""
	    #if [[ $(echo "!echo "$?"") -eq 0 ]]; then
	    echo "echo "COMPLETE: \"$line\"""
	    #else
	    #    echo "echo "ERROR:    \"$line\"""
            #fi
        fi
    done <<< "$LINESD"
}

#DOWNLOAD FILES
DLFL () {
    #"
    while read -r line; do
        #line=$(echo "$line" | sed 's|SsS$| |') # handle trailing whitespace
        line=$(echo "$line" | sed 's|SsS$| |' | sed 's/\[/"\["/g') # handle trailing whitespace and brackets
        if [[ -z $line ]]; then
            continue
        fi
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: pget \"$line\" -o "$local_dl_dir"/\"$line\""
        elif [[ $norm == True ]]; then
            echo "pget -n 5 \"$line\" -o "$local_dl_dir"/\"$line\"; !echo COMPLETE: \"$line\""
        else
            echo "pget -n 5 \"$line\" -o "$local_dl_dir"/\"$line\" && rm -f \"$line\""
            echo "echo "COMPLETE: \"$line\"""
        fi
    done <<< "$LINESF"
}

COMPLETE () {
    if [[ -n $exitflag ]]; then
	    return 0
    fi
    rm -f /tmp/alftp.lock
    trap - SIGINT SIGTERM
    if [[ $rm_list == True ]]; then
        rm -f "$listfile"
    fi
    if [[ $suspend_old == True ]]; then
        mv "$oldfile" "$listfile"
    fi
}


function chkrmd () {
    if [[ -d $1 ]]; then
        rm -rf "${1:?}/"
    fi
}

function chkrmf () {
    if [[ -e $1 ]] && [[ ! -z $(ls $1) ]]; then
        rm "$1"
    fi
}

UNRAR_FUN () {
    pdir="$1"
    ext='*.rar'
    cdir=$(find "$pdir" -name "$ext" -exec dirname {} + | sort -u)
    if [[ -z $cdir ]]; then
        return 0
    fi
    while read -r line; do
        cd "$line" && \
        unrar e -n -r -or "$line" && sleep 1 && \
        find "$line" -type f \( -regex ".*.rar$" -o -regex '.*.r[0-9]+$' \) -exec rm {} +
        find "$line" -type f \( -name "*.sfv" -o -name "*.nfo" \) -exec rm {} +
        find "$line" -type d -iname "sample" -exec rm -rf {} +
        find "$line" -type d -iname "screens" -exec rm -rf {} +
        find "$line" -type d -empty -delete

    done <<< "$cdir"
}

