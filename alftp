# Fail early, and by name, rather than letting lftp report something cryptic.
validate_config () {
    missing=""
    if [[ -z $server ]]; then missing="$missing server"; fi
    if [[ -z $username ]]; then missing="$missing username"; fi
    if [[ -z $port ]]; then missing="$missing port"; fi
    if [[ -n $missing ]]; then
        echo "alftp: missing required setting(s):$missing" >&2
        echo "Set them in $config or $configsrc, or pass -s/-u/-P." >&2
        exit 1
    fi
}

WELCOME () {
if [[ -z $(command -v lftp) ]]; then
    echo "lftp is not installed."
    exit 1
fi
validate_config
if [[ -z $listfile ]]; then
    listfile="$HOME/.cache/alftp/alftp.list"
fi
if [[ -z $logfile ]]; then
    logfile="$HOME/.cache/alftp/alftp.log"
fi
if ! mkdir -p "$(dirname "$listfile")" "$(dirname "$logfile")"; then
    echo "alftp: cannot create directory for listfile/logfile." >&2
    exit 1
fi
if ! touch "$listfile"; then
    echo "alftp: cannot write listfile \"$listfile\"." >&2
    exit 1
fi
# Derived here so the parent and the in-session helper agree on it.
listfile2="$listfile"2
listfile3="$listfile"3
}

# Quote a value for lftp's own (shell-like) command parser.
lftp_quote () {
    quoted=$1
    quoted=${quoted//\\/\\\\}
    quoted=${quoted//\"/\\\"}
    printf '"%s"' "$quoted"
}

# Quote a value for the $SHELL that lftp's "!" command hands the line to.
sh_quote () {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

# The credentials live in the (0600, mktemp'd) script rather than on lftp's
# command line, so they no longer show up in ps output.
open_cmd () {
    printf 'open'
    if [[ -n $username ]]; then
        printf ' --user %s --password %s' \
            "$(lftp_quote "$username")" "$(lftp_quote "$password")"
    fi
    if [[ -n $port ]]; then
        printf ' -p %s' "$(lftp_quote "$port")"
    fi
    printf ' %s\n' "$(lftp_quote "$server")"
}

# Every lftp session is generated into a temp script first, so that what was
# actually sent to lftp can be inspected when something goes wrong (the file is
# kept on failure, or whenever ALFTP_DEBUG is set) instead of only existing
# inside a here-doc. -f (rather than stdin) is what lets the session shell out
# to an interactive editor: the helper it spawns inherits lftp's stdin, which
# is still the terminal.
run_lftp_script () {
    scriptfile="$1"
    rc=0
    if [[ -n ${ALFTP_DEBUG:-} ]]; then
        echo "alftp: lftp commands in $scriptfile" >&2
    fi
    export LC_ALL=C.UTF-8
    lftp -f "$scriptfile" || rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "alftp: lftp exited $rc; the commands sent are in $scriptfile" >&2
    elif [[ -z ${ALFTP_DEBUG:-} ]]; then
        rm -f "$scriptfile"
    fi
    return $rc
}

# The remote listing has no size for directories, so with -ds we ask lftp for
# one. This walks the whole tree below $remote_dl_dir (one listing per
# subdirectory), which is why it is opt-in rather than always on. Prints
# nothing when the flag is off, so the line simply vanishes from the script.
du_cmd () {
    if [[ $dir_sizes == True ]]; then
        printf 'du -h --max-depth=1 . > %s\n' "$(lftp_quote "$listfile3")"
    fi
}

CREATE_LIST () {
    oldfile="$listfile"_old
    cp "$listfile" "$oldfile"

    scriptfile=$(mktemp "${TMPDIR:-/tmp}/alftp.list.XXXXXX")
    #DO NOT INDENT CONTENTS
    cat > "$scriptfile" << EOF
$(open_cmd)
$(set_opts)
cd "$remote_dl_dir"
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > "$listfile"
$(du_cmd)
cd "$data_dir""$dirname"
cls -1 > "$listfile2"
quit
EOF
    run_lftp_script "$scriptfile"
}

# Listing, file selection and download in one login. lftp lists into
# $listfile, shells out to this same script (which runs the editor and turns
# the selection into mirror/pget commands), then sources what it wrote -- so
# the connection opened for the listing is the one that does the transfer.
SINGLE_SESSION () {
    oldfile="$listfile"_old
    cp "$listfile" "$oldfile"

    emitfile=$(mktemp "${TMPDIR:-/tmp}/alftp.emit.XXXXXX")
    argvfile=$(mktemp "${TMPDIR:-/tmp}/alftp.argv.XXXXXX")
    if [[ ${#ARGV[@]} -gt 0 ]]; then
        printf '%s\0' "${ARGV[@]}" > "$argvfile"
    else
        : > "$argvfile"
    fi

    scriptfile=$(mktemp "${TMPDIR:-/tmp}/alftp.session.XXXXXX")
    #DO NOT INDENT CONTENTS
    cat > "$scriptfile" << EOF
$(open_cmd)
set net:idle never
$(set_opts)
cd "$remote_dl_dir"
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > "$listfile"
$(du_cmd)
cd "$data_dir""$dirname"
cls -1 > "$listfile2"
cd "$remote_dl_dir"
!env ALFTP_EMIT_DL=$(sh_quote "$emitfile") ALFTP_ARGV=$(sh_quote "$argvfile") bash $(sh_quote "$self")
source "$emitfile"
quit
EOF
    run_lftp_script "$scriptfile"
    rc=$?
    if [[ -n ${ALFTP_DEBUG:-} ]]; then
        echo "alftp: download commands in $emitfile, argv in $argvfile" >&2
    else
        rm -f "$emitfile" "$argvfile"
    fi
    return $rc
}

# Runs inside the lftp session, spawned by the "!" line above.
EMIT_DL () {
    EDIT_LIST
    TYPE
    { DLDR; DLFL; DLRM; } > "$ALFTP_EMIT_DL"
}

NEW_SESSION () {
    if [[ $just_login == True ]]; then
	# Interactive session, so the open command (and with it the credentials)
	# comes from a temp rc file instead of the command line, keeping the
	# password out of ps output like the generated sessions do.
	openrc=$(mktemp "${TMPDIR:-/tmp}/alftp.open.XXXXXX")
	open_cmd > "$openrc"
	lftp --rcfile "$openrc"
	rm -f "$openrc"
	exitflag=True
    elif [[ $old_only != True ]] && [[ $just_login != True ]]; then

        if [[ $two_session == True ]]; then
            CREATE_LIST
            EDIT_LIST
            TYPE
            if [[ ! -z $LINESF ]] || [[ ! -z $LINESD ]] || [[ ! -z $LINESR ]]; then
                DOWNLD
                POST_PROCESS
            fi
        else
            SINGLE_SESSION
            # The selection was made by the helper inside the session; re-run
            # TYPE here against the same (edited) list to recover what was
            # downloaded, so post-processing knows what to work on.
            TYPE
            POST_PROCESS
        fi
        rm -f "$listfile2" "$listfile3"
    fi
}

# Turn the raw "size date time name" listing lftp writes into the columnar
# form the user edits: name first, then size, then date, padded so the columns
# line up. Only the name is meaningful when the file is read back (see TYPE),
# the other columns are there to inform the selection. Lines that do not look
# like a listing entry (a server that omits the date, say) are passed through
# untouched, so nothing is ever dropped from the list.
# The awk that does it, factored out so the picker can put a freshly fetched
# subdirectory listing through the same transformation ($2 is the du file, or
# empty when there is none).
format_columns () {
    awk -v dufile="$2" '
        # With -ds, $listfile3 holds "size<TAB>./name" for every directory
        # (plus a grand total for "."), which fills the size column the
        # listing leaves empty.
        BEGIN {
            while (dufile != "" && (getline duline < dufile) > 0) {
                tab = index(duline, "\t")
                if (tab == 0) { continue }
                duname = substr(duline, tab + 1)
                sub(/^\.\//, "", duname)
                sub(/\/+$/, "", duname)
                if (duname == "" || duname == ".") { continue }
                dusize[duname] = substr(duline, 1, tab - 1)
            }
            if (dufile != "") { close(dufile) }
        }
        {
            line[NR] = $0
            # "size date time name" (files) and, for directories, which lftp
            # lists without a size, "date time name".
            if (match($0, /^[ \t]*[^ \t]+[ \t]+[0-9][0-9-]+ [0-9][0-9:]+ /)) {
                head = substr($0, 1, RLENGTH)
                name[NR] = substr($0, RLENGTH + 1)
                sub(/^[ \t]+/, "", head)
                split(head, f, / +/)
                size[NR] = f[1]
                date[NR] = f[2] " " f[3]
            } else if (match($0, /^[ \t]*[0-9][0-9-]+ [0-9][0-9:]+ /)) {
                head = substr($0, 1, RLENGTH)
                name[NR] = substr($0, RLENGTH + 1)
                sub(/^[ \t]+/, "", head)
                split(head, f, / +/)
                size[NR] = ""
                date[NR] = f[1] " " f[2]
            }
            # cls -F marks directories with a trailing "/". Their size, when
            # the server gives one at all, is the size of the directory entry
            # rather than of its contents, so du wins wherever it has an
            # answer.
            if (NR in name && name[NR] ~ /\/$/) {
                key = name[NR]
                sub(/\/$/, "", key)
                if (key in dusize) { size[NR] = dusize[key] }
            }
            if (NR in name) {
                if (length(name[NR]) > namew) { namew = length(name[NR]) }
                if (length(size[NR]) > sizew) { sizew = length(size[NR]) }
            }
        }
        END {
            for (i = 1; i <= NR; i++) {
                if (i in name) {
                    printf "%-*s  %*s  %s\n", namew, name[i], sizew, size[i], date[i]
                } else {
                    print line[i]
                }
            }
        }
    ' "$1"
}

FORMAT_LIST () {
    if [[ ! -s $listfile ]]; then
        return 0
    fi
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/alftp.fmt.XXXXXX")
    dufile=""
    if [[ -n $listfile3 ]] && [[ -s $listfile3 ]]; then
        dufile="$listfile3"
    fi
    format_columns "$listfile" "$dufile" > "$tmpfile" && mv "$tmpfile" "$listfile"
    rm -f "$tmpfile"
}

# ------------------------------------------------------------------- PICKER --
# The listing is picked either in $editor (the original way) or in the terminal
# UI below, which is the default wherever the terminal can drive it. There are
# no curses bindings for bash, so the UI is terminfo strings from tput written
# to whichever fds reach the terminal -- /dev/tty when there is one, stdin and
# stdout otherwise, which is what makes it work in the single-session path,
# where this code runs inside the "!" shell-out from lftp.
#
# What the user picks is a tree: Tab lists a remote directory (over a short
# lived lftp login of its own, since the session that spawned this one is
# blocked waiting for it) and its entries appear indented underneath. A node
# carries one of three states -- nothing, "+" download, "-" remove the source
# symlink -- and a directory holding a selection it does not itself have shows
# "*". Everything below is indexed by node id; TUI_ORDER is the tree flattened
# for display and TUI_VIS the part of it that open directories make visible.

# What the UI needs. Anything missing (no terminal, no terminfo, a terminal too
# small or too dumb) falls back to $editor instead of failing the run; $tui_why
# says which requirement was the problem.
tui_usable () {
    tui_why=""
    if [[ $picker == editor ]]; then
        tui_why="picker is set to editor"
        return 1
    fi
    if ! command -v tput > /dev/null 2>&1; then
        tui_why="tput (ncurses) is not installed"
        return 1
    fi
    if [[ -z ${TERM:-} ]] || [[ $TERM == dumb ]]; then
        tui_why="TERM is unset or dumb"
        return 1
    fi
    # /dev/tty is the first choice, but lftp's "!" hands its child the
    # terminal on stdin/stdout without a controlling terminal (tpgid -1), and
    # that is where this runs in the single-session path -- so stdin/stdout
    # are a perfectly good fallback, and only having neither rules the UI out.
    tui_dev_tty=0
    if ( : <> /dev/tty ) 2> /dev/null; then
        tui_dev_tty=1
    elif [[ ! -t 0 ]] || [[ ! -t 1 ]]; then
        tui_why="not attached to a terminal"
        return 1
    fi
    tui_caps
    if [[ -z $t_rev ]] || [[ -z $t_sgr0 ]]; then
        tui_why="terminfo has no reverse video for $TERM"
        return 1
    fi
    tui_size
    if (( TUI_LINES < 6 )) || (( TUI_COLS < 20 )); then
        tui_why="terminal is only ${TUI_COLS}x${TUI_LINES}"
        return 1
    fi
    return 0
}

# Every capability is looked up once: each tput is a fork, and the UI redraws
# on every keystroke. A capability the terminal lacks comes back empty, which
# is exactly what should then be printed for it.
tui_caps () {
    t_smcup=$(tput smcup 2> /dev/null)
    t_rmcup=$(tput rmcup 2> /dev/null)
    t_civis=$(tput civis 2> /dev/null)
    t_cnorm=$(tput cnorm 2> /dev/null)
    t_clear=$(tput clear 2> /dev/null)
    t_home=$(tput home 2> /dev/null)
    t_el=$(tput el 2> /dev/null)
    t_rev=$(tput rev 2> /dev/null)
    t_bold=$(tput bold 2> /dev/null)
    t_dim=$(tput dim 2> /dev/null)
    t_sgr0=$(tput sgr0 2> /dev/null)
}

# stty knows the size of the terminal even when stdout is a pipe, which tput
# does not; tput is the fallback and a sane 80x24 the fallback of last resort.
tui_size () {
    if [[ $tui_dev_tty == 1 ]]; then
        tui_scratch=$(stty size < /dev/tty 2> /dev/null) || tui_scratch=""
    else
        tui_scratch=$(stty size <&"$TUI_IN" 2> /dev/null) || tui_scratch=""
    fi
    TUI_LINES=${tui_scratch%% *}
    TUI_COLS=${tui_scratch##* }
    if [[ ! $TUI_LINES =~ ^[1-9][0-9]*$ ]]; then
        TUI_LINES=$(tput lines 2> /dev/null)
    fi
    if [[ ! $TUI_COLS =~ ^[1-9][0-9]*$ ]]; then
        TUI_COLS=$(tput cols 2> /dev/null)
    fi
    if [[ ! $TUI_LINES =~ ^[1-9][0-9]*$ ]]; then
        TUI_LINES=24
    fi
    if [[ ! $TUI_COLS =~ ^[1-9][0-9]*$ ]]; then
        TUI_COLS=80
    fi
    tui_rows_calc
}

# Rows left for the list once the title, the column header and the footer have
# had their line each.
tui_rows_calc () {
    TUI_ROWS=$(( TUI_LINES - 3 ))
    if (( TUI_ROWS < 1 )); then
        TUI_ROWS=1
    fi
}

tui_reset () {
    TUI_NAME=(); TUI_PATH=(); TUI_SIZE=(); TUI_DATE=()
    TUI_DEPTH=(); TUI_PARENT=(); TUI_ISDIR=(); TUI_OPEN=(); TUI_LOADED=()
    TUI_STATE=(); TUI_SELCNT=(); TUI_POS=()
    TUI_ORDER=(); TUI_VIS=()
    tui_nodes=0; TUI_N=0; tui_nsel=0; tui_nrm=0
}

# The classifier cls -F puts on a name ("/" for a directory, "@" for a symlink)
# is display only: it has no place in a path handed back to lftp.
tui_strip_class () {
    tui_stripped=${1%[/@*]}
}

tui_add_node () {
    tui_new_id=$tui_nodes
    tui_nodes=$(( tui_nodes + 1 ))
    TUI_NAME[tui_new_id]=$1
    TUI_SIZE[tui_new_id]=$2
    TUI_DATE[tui_new_id]=$3
    TUI_PARENT[tui_new_id]=$4
    TUI_ISDIR[tui_new_id]=$5
    TUI_STATE[tui_new_id]=0
    TUI_SELCNT[tui_new_id]=0
    TUI_OPEN[tui_new_id]=0
    TUI_LOADED[tui_new_id]=0
    TUI_POS[tui_new_id]=0
    if (( $4 < 0 )); then
        TUI_DEPTH[tui_new_id]=0
        # Top level keeps the name exactly as the listing had it, classifier
        # and all, because TYPE resolves those against $listfile2 the way it
        # always has.
        TUI_PATH[tui_new_id]=$1
    else
        TUI_DEPTH[tui_new_id]=$(( TUI_DEPTH[$4] + 1 ))
        tui_strip_class "${TUI_PATH[$4]}"
        tui_scratch=$tui_stripped
        tui_strip_class "$1"
        # A path below the top level is the one thing TYPE cannot look up, so
        # it carries its own type: a trailing "/" means directory.
        if [[ $5 == 1 ]]; then
            TUI_PATH[tui_new_id]="$tui_scratch/$tui_stripped/"
        else
            TUI_PATH[tui_new_id]="$tui_scratch/$tui_stripped"
        fi
    fi
}

# Split a formatted listing into name/size/date records. Any marker written by
# a previous pass comes off here: a reloaded list starts deselected like any
# other.
tui_parse_listing () {
    awk '
        {
            line = $0
            sub(/^[-+*#]/, "", line)
            if (line ~ /^[ \t]*$/) { next }
            if (match(line, /[ \t][ \t]+[^ \t]*[ \t]+[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/)) {
                nm = substr(line, 1, RSTART - 1)
                n = split(substr(line, RSTART), f, /[ \t]+/)
                if (n >= 4) { sz = f[2]; dt = f[3] " " f[4] } else { sz = ""; dt = f[2] " " f[3] }
            } else {
                nm = line
                sz = ""
                dt = ""
            }
            sub(/[ \t]+$/, "", nm)
            if (nm == "" || nm == "." || nm == ".." || nm == "./" || nm == "../") { next }
            print nm "\t" sz "\t" dt
        }
    ' "$1"
}

# The top level of the tree. Which of those entries are directories is the same
# question TYPE asks, and it has the same answer: $listfile2, the listing of
# the real directory behind the symlinks.
tui_load () {
    tui_reset
    unset TUI_DIRMAP
    declare -gA TUI_DIRMAP=()
    if [[ -n $listfile2 ]] && [[ -s $listfile2 ]]; then
        while IFS= read -r tui_scratch || [[ -n $tui_scratch ]]; do
            if [[ $tui_scratch == */ ]]; then
                TUI_DIRMAP[${tui_scratch%/}]=1
            fi
        done < "$listfile2"
    fi
    while IFS=$'\t' read -r tui_nm tui_sz tui_dt; do
        tui_isdir=0
        tui_strip_class "$tui_nm"
        if [[ $tui_nm == */ ]] || [[ -n ${TUI_DIRMAP[$tui_stripped]:-} ]]; then
            tui_isdir=1
        fi
        tui_add_node "$tui_nm" "$tui_sz" "$tui_dt" -1 "$tui_isdir"
        TUI_ORDER+=("$tui_new_id")
    done < <(tui_parse_listing "$listfile")
    tui_reindex
    tui_rebuild_vis
    tui_widths
}

tui_reindex () {
    for (( tui_i = 0; tui_i < ${#TUI_ORDER[@]}; tui_i++ )); do
        TUI_POS[${TUI_ORDER[tui_i]}]=$tui_i
    done
}

# Everything under a closed directory drops out of view; TUI_N counts what is
# left, so movement and drawing work on rows without knowing about the tree.
tui_rebuild_vis () {
    TUI_VIS=()
    tui_skipd=-1
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( tui_skipd >= 0 )) && (( TUI_DEPTH[tui_id] > tui_skipd )); then
            continue
        fi
        tui_skipd=-1
        TUI_VIS+=("$tui_id")
        if (( TUI_ISDIR[tui_id] == 1 )) && (( TUI_OPEN[tui_id] == 0 )); then
            tui_skipd=${TUI_DEPTH[tui_id]}
        fi
    done
    TUI_N=${#TUI_VIS[@]}
    if (( tui_cur >= TUI_N )); then
        tui_cur=$(( TUI_N - 1 ))
    fi
    if (( tui_cur < 0 )); then
        tui_cur=0
    fi
    tui_scroll
}

# Children are inserted straight after their parent, so a subtree is always a
# run of consecutive entries -- which is what makes these two cheap.
tui_subtree () {
    tui_r0=$(( $1 + 1 ))
    tui_r1=$tui_r0
    tui_d=${TUI_DEPTH[${TUI_ORDER[$1]}]}
    while (( tui_r1 < ${#TUI_ORDER[@]} )) && (( TUI_DEPTH[${TUI_ORDER[tui_r1]}] > tui_d )); do
        tui_r1=$(( tui_r1 + 1 ))
    done
}

tui_children () {
    tui_kids=()
    tui_subtree "${TUI_POS[$1]}"
    tui_d=$(( TUI_DEPTH[$1] + 1 ))
    for (( tui_i = tui_r0; tui_i < tui_r1; tui_i++ )); do
        if (( TUI_DEPTH[${TUI_ORDER[tui_i]}] == tui_d )); then
            tui_kids+=("${TUI_ORDER[tui_i]}")
        fi
    done
}

# The nearest ancestor already marked for download, if any: everything under it
# comes along, so its descendants show "+" without holding a state of their own.
tui_sel_ancestor () {
    tui_anc=-1
    tui_p=${TUI_PARENT[$1]}
    while (( tui_p >= 0 )); do
        if (( TUI_STATE[tui_p] == 1 )); then
            tui_anc=$tui_p
            return 0
        fi
        tui_p=${TUI_PARENT[tui_p]}
    done
    return 0
}

# The one place a state changes, so the "some of this directory is selected"
# counters can be kept up to date on the way past.
tui_set_state () {
    tui_old=${TUI_STATE[$1]}
    if (( tui_old == $2 )); then
        return 0
    fi
    TUI_STATE[$1]=$2
    tui_delta=0
    if (( tui_old == 1 )); then
        tui_delta=$(( tui_delta - 1 ))
    fi
    if (( $2 == 1 )); then
        tui_delta=$(( tui_delta + 1 ))
    fi
    if (( tui_old == 2 )); then
        tui_nrm=$(( tui_nrm - 1 ))
    fi
    if (( $2 == 2 )); then
        tui_nrm=$(( tui_nrm + 1 ))
    fi
    if (( tui_delta != 0 )); then
        tui_nsel=$(( tui_nsel + tui_delta ))
        tui_p=${TUI_PARENT[$1]}
        while (( tui_p >= 0 )); do
            TUI_SELCNT[tui_p]=$(( TUI_SELCNT[tui_p] + tui_delta ))
            tui_p=${TUI_PARENT[tui_p]}
        done
    fi
}

tui_clear_subtree () {
    tui_subtree "${TUI_POS[$1]}"
    for (( tui_i = tui_r0; tui_i < tui_r1; tui_i++ )); do
        tui_set_state "${TUI_ORDER[tui_i]}" 0
    done
}

# Taking one entry out of a directory that was selected whole: the directory
# stops being a single mirror and becomes the list of everything it holds
# except this one.
tui_split_ancestor () {
    tui_chain=("$1")
    tui_p=${TUI_PARENT[$1]}
    while (( tui_p >= 0 )) && (( tui_p != $2 )); do
        tui_chain=("$tui_p" ${tui_chain[@]+"${tui_chain[@]}"})
        tui_p=${TUI_PARENT[tui_p]}
    done
    tui_set_state "$2" 0
    tui_walk=$2
    for tui_step in ${tui_chain[@]+"${tui_chain[@]}"}; do
        tui_children "$tui_walk"
        for tui_kid in ${tui_kids[@]+"${tui_kids[@]}"}; do
            if (( tui_kid != tui_step )); then
                tui_set_state "$tui_kid" 1
            fi
        done
        tui_walk=$tui_step
    done
    tui_set_state "$1" 0
}

tui_toggle () {
    tui_node=${TUI_VIS[tui_cur]}
    if (( TUI_STATE[tui_node] == 2 )); then
        tui_set_state "$tui_node" 1
        return 0
    fi
    tui_sel_ancestor "$tui_node"
    if (( tui_anc >= 0 )); then
        tui_split_ancestor "$tui_node" "$tui_anc"
        return 0
    fi
    if (( TUI_STATE[tui_node] == 1 )); then
        tui_set_state "$tui_node" 0
        return 0
    fi
    # A directory showing "*" holds a selection made further down; space takes
    # all of it back rather than swallowing the directory whole.
    if (( TUI_SELCNT[tui_node] > 0 )); then
        tui_clear_subtree "$tui_node"
        return 0
    fi
    tui_clear_subtree "$tui_node"
    tui_set_state "$tui_node" 1
}

# "d" marks the source symlink for removal, which only the top level has one
# of: everything below is a real file or directory inside the target.
tui_mark_remove () {
    tui_node=${TUI_VIS[tui_cur]}
    if (( TUI_DEPTH[tui_node] > 0 )); then
        tui_msg="only a top-level entry has a symlink to remove"
        return 0
    fi
    if (( TUI_STATE[tui_node] == 2 )); then
        tui_set_state "$tui_node" 0
    else
        tui_clear_subtree "$tui_node"
        tui_set_state "$tui_node" 2
    fi
}

# a/A work on the download selection and leave the "-" marks alone: they are a
# separate decision about the remote side.
tui_set_all () {
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( TUI_DEPTH[tui_id] > 0 )); then
            tui_set_state "$tui_id" 0
        elif (( TUI_STATE[tui_id] != 2 )); then
            tui_set_state "$tui_id" "$1"
        fi
    done
}

# Column widths over every node loaded, indentation included, so the columns
# stay put when a directory is opened or closed.
tui_widths () {
    tui_namew=0
    tui_sizew=0
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        tui_i=$(( TUI_DEPTH[tui_id] * 2 + ${#TUI_NAME[tui_id]} ))
        if (( tui_i > tui_namew )); then
            tui_namew=$tui_i
        fi
        if (( ${#TUI_SIZE[tui_id]} > tui_sizew )); then
            tui_sizew=${#TUI_SIZE[tui_id]}
        fi
    done
}

tui_marker () {
    if (( TUI_STATE[$1] == 2 )); then
        tui_mark="-"
    elif (( TUI_STATE[$1] == 1 )); then
        tui_mark="+"
    else
        tui_sel_ancestor "$1"
        if (( tui_anc >= 0 )); then
            tui_mark="+"
        elif (( TUI_SELCNT[$1] > 0 )); then
            tui_mark="*"
        else
            tui_mark=" "
        fi
    fi
}

# Cut a line to the width of the terminal so nothing wraps and shifts the rest
# of the screen down.
tui_fit () {
    if (( $2 <= 0 )); then
        tui_fitted=""
    elif (( ${#1} > $2 )); then
        tui_fitted=${1:0:$2}
    else
        tui_fitted=$1
    fi
}

# One screen, built as a single string and written in one go: no cursor
# addressing (that would be a tput fork per row) and no flicker. Every line is
# padded and cleared to the right edge, so what was there before is covered.
tui_draw () {
    tui_left="alftp  ${remote_dl_dir}"
    tui_right="${tui_nsel} selected"
    if (( tui_nrm > 0 )); then
        tui_right="$tui_right, $tui_nrm to unlink"
    fi
    tui_pad=$(( TUI_COLS - ${#tui_left} - ${#tui_right} - 2 ))
    if (( tui_pad < 1 )); then
        tui_fit "$tui_left" $(( TUI_COLS - ${#tui_right} - 3 ))
        tui_left=$tui_fitted
        tui_pad=1
    fi
    printf -v tui_line ' %s%*s%s ' "$tui_left" "$tui_pad" "" "$tui_right"
    tui_fit "$tui_line" "$TUI_COLS"
    tui_out="${t_home}${t_rev}${tui_fitted}${t_sgr0}${t_el}"$'\n'

    # Column header, lined up with the two-column selection gutter.
    printf -v tui_line '  %-*s  %*s  %s' "$tui_namew" "NAME" "$tui_sizew" "SIZE" "DATE"
    tui_fit "$tui_line" "$TUI_COLS"
    tui_out+="${t_bold}${tui_fitted}${t_sgr0}${t_el}"$'\n'

    for (( tui_i = tui_top; tui_i < tui_top + TUI_ROWS; tui_i++ )); do
        if (( tui_i < TUI_N )); then
            tui_id=${TUI_VIS[tui_i]}
            tui_marker "$tui_id"
            printf -v tui_line '%s %*s%-*s  %*s  %s' "$tui_mark" \
                "$(( TUI_DEPTH[tui_id] * 2 ))" "" \
                "$(( tui_namew - TUI_DEPTH[tui_id] * 2 ))" "${TUI_NAME[tui_id]}" \
                "$tui_sizew" "${TUI_SIZE[tui_id]}" "${TUI_DATE[tui_id]}"
            tui_fit "$tui_line" "$TUI_COLS"
            if (( tui_i == tui_cur )); then
                printf -v tui_line '%-*s' "$TUI_COLS" "$tui_fitted"
                tui_out+="${t_rev}${tui_line}${t_sgr0}${t_el}"$'\n'
            else
                tui_out+="${tui_fitted}${t_el}"$'\n'
            fi
        else
            tui_out+="${t_el}"$'\n'
        fi
    done

    if [[ -n $tui_prompt ]]; then
        tui_fit "$tui_prompt" "$TUI_COLS"
        printf -v tui_line '%-*s' "$TUI_COLS" "$tui_fitted"
        tui_out+="${t_rev}${tui_line}${t_sgr0}${t_el}"
    else
        if [[ -n $tui_msg ]]; then
            tui_line=$tui_msg
        elif (( TUI_COLS >= 74 )); then
            tui_line="j/k move  space toggle  tab open dir  d unlink  a all  A none  q quit"
        else
            tui_line="j/k  space  tab  d  a/A  q"
        fi
        if (( TUI_N > TUI_ROWS )); then
            printf -v tui_line '%s   %s-%s/%s' "$tui_line" \
                "$(( tui_top + 1 ))" "$(( tui_top + TUI_ROWS < TUI_N ? tui_top + TUI_ROWS : TUI_N ))" "$TUI_N"
        fi
        tui_fit " $tui_line" "$TUI_COLS"
        tui_out+="${t_dim}${tui_fitted}${t_sgr0}${t_el}"
    fi
    printf '%s' "$tui_out" >&"$TUI_OUT"
}

# One keystroke, or one escape sequence: after ESC the rest of the sequence is
# already in the buffer, so a short timeout tells a real arrow key from a bare
# ESC without making the UI feel sluggish.
tui_read_key () {
    TUI_KEY=""
    IFS= read -rN1 -u "$TUI_IN" TUI_KEY || return 1
    if [[ $TUI_KEY == $'\e' ]]; then
        while IFS= read -rN1 -t 0.05 -u "$TUI_IN" tui_scratch; do
            TUI_KEY+=$tui_scratch
            if [[ $tui_scratch == [A-Za-z~] ]]; then
                break
            fi
        done
    fi
    return 0
}

# Keys to actions. Both the letter and the escape-sequence spelling of every
# movement key land here, which is also what makes the mapping testable
# without a terminal.
tui_key_action () {
    case $1 in
        j|$'\e[B'|$'\eOB')                     tui_action=down ;;
        k|$'\e[A'|$'\eOA')                     tui_action=up ;;
        0|$'\e[H'|$'\eOH'|$'\e[1~'|$'\e[7~')   tui_action=top ;;
        G|$'\e[F'|$'\eOF'|$'\e[4~'|$'\e[8~')   tui_action=bottom ;;
        $'\e[5~')                              tui_action=pgup ;;
        $'\e[6~')                              tui_action=pgdn ;;
        ' '|$'\n'|$'\r')                       tui_action=toggle ;;
        $'\t')                                 tui_action=open ;;
        d)                                     tui_action="unlink" ;;
        a)                                     tui_action=all ;;
        A)                                     tui_action=none ;;
        q|$'\e')                               tui_action=quit ;;
        $'\f')                                 tui_action=redraw ;;
        *)                                     tui_action=ignore ;;
    esac
}

tui_move () {
    case $tui_action in
        up)     if (( tui_cur > 0 )); then tui_cur=$(( tui_cur - 1 )); fi ;;
        down)   if (( tui_cur < TUI_N - 1 )); then tui_cur=$(( tui_cur + 1 )); fi ;;
        top)    tui_cur=0 ;;
        bottom) tui_cur=$(( TUI_N - 1 )) ;;
        pgup)   tui_cur=$(( tui_cur - TUI_ROWS )) ;;
        pgdn)   tui_cur=$(( tui_cur + TUI_ROWS )) ;;
    esac
    if (( tui_cur < 0 )); then
        tui_cur=0
    fi
    if (( tui_cur > TUI_N - 1 )); then
        tui_cur=$(( TUI_N - 1 ))
    fi
    tui_scroll
}

# Keep the cursor on screen, and the screen full: after a resize or a jump to
# the end there is no reason to leave blank rows below the last entry.
tui_scroll () {
    if (( tui_cur < tui_top )); then
        tui_top=$tui_cur
    fi
    if (( tui_cur >= tui_top + TUI_ROWS )); then
        tui_top=$(( tui_cur - TUI_ROWS + 1 ))
    fi
    if (( tui_top > TUI_N - TUI_ROWS )); then
        tui_top=$(( TUI_N - TUI_ROWS ))
    fi
    if (( tui_top < 0 )); then
        tui_top=0
    fi
}

# List one remote directory. The session that spawned this one is blocked in
# its "!" waiting for the picker to finish, so this is a login of its own --
# once per directory, since what it finds stays in the tree.
tui_fetch () {
    tui_strip_class "${TUI_PATH[$1]}"
    tui_msg="listing ${TUI_NAME[$1]} ..."
    tui_draw
    tui_raw=$(mktemp "${TMPDIR:-/tmp}/alftp.sub.XXXXXX")
    tui_log=$(mktemp "${TMPDIR:-/tmp}/alftp.sublog.XXXXXX")
    tui_script=$(mktemp "${TMPDIR:-/tmp}/alftp.subcmd.XXXXXX")
    #DO NOT INDENT CONTENTS
    cat > "$tui_script" << EOF
$(open_cmd)
$(set_opts)
cd "$remote_dl_dir"
cd $(lftp_quote "$tui_stripped")
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > $(lftp_quote "$tui_raw")
quit
EOF
    tui_msg=""
    if ! lftp -f "$tui_script" < /dev/null > "$tui_log" 2>&1; then
        tui_msg="could not list ${TUI_NAME[$1]}: $(head -n 1 "$tui_log")"
        if [[ -n ${ALFTP_DEBUG:-} ]]; then
            tui_msg="$tui_msg (script $tui_script)"
        else
            rm -f "$tui_script" "$tui_raw" "$tui_log"
        fi
        return 1
    fi
    tui_kidsnew=()
    while IFS=$'\t' read -r tui_nm tui_sz tui_dt; do
        tui_isdir=0
        if [[ $tui_nm == */ ]]; then
            tui_isdir=1
        fi
        tui_add_node "$tui_nm" "$tui_sz" "$tui_dt" "$1" "$tui_isdir"
        tui_kidsnew+=("$tui_new_id")
    done < <(format_columns "$tui_raw" "" | tui_parse_listing /dev/stdin)
    tui_i=${TUI_POS[$1]}
    TUI_ORDER=("${TUI_ORDER[@]:0:tui_i + 1}" ${tui_kidsnew[@]+"${tui_kidsnew[@]}"} \
               "${TUI_ORDER[@]:tui_i + 1}")
    TUI_LOADED[$1]=1
    tui_reindex
    tui_widths
    if (( ${#tui_kidsnew[@]} == 0 )); then
        tui_msg="${TUI_NAME[$1]} is empty"
    fi
    rm -f "$tui_script" "$tui_raw" "$tui_log"
    return 0
}

tui_toggle_open () {
    tui_node=${TUI_VIS[tui_cur]}
    if (( TUI_ISDIR[tui_node] == 0 )); then
        tui_msg="${TUI_NAME[tui_node]} is not a directory"
        return 0
    fi
    if (( TUI_OPEN[tui_node] == 1 )); then
        TUI_OPEN[tui_node]=0
        tui_rebuild_vis
        return 0
    fi
    if (( TUI_LOADED[tui_node] == 0 )); then
        if ! tui_fetch "$tui_node"; then
            return 0
        fi
    fi
    TUI_OPEN[tui_node]=1
    tui_rebuild_vis
}

# q asks before it does anything irreversible. Drawn as the footer of the
# normal screen, so the list stays visible behind the question.
tui_quit_prompt () {
    tui_prompt="quit: (c)ancel   (s)ave and download   (e)xit without downloading"
    tui_answer=""
    while [[ -z $tui_answer ]]; do
        tui_draw
        if ! tui_read_key; then
            tui_answer="exit"
            break
        fi
        case $TUI_KEY in
            c|C|$'\e')     tui_answer=cancel ;;
            s|S)           tui_answer=save ;;
            e|E|q|Q)       tui_answer="exit" ;;
        esac
    done
    tui_prompt=""
}

# The event loop. Kept free of terminal setup so a test can drive it with a
# stubbed tui_read_key and TUI_OUT pointed somewhere harmless.
tui_loop () {
    tui_result=""
    while true; do
        if [[ $tui_resized == 1 ]]; then
            tui_resized=0
            tui_size
            tui_scroll
            printf '%s' "$t_clear" >&"$TUI_OUT"
        fi
        tui_draw
        if ! tui_read_key; then
            tui_result="exit"
            return 0
        fi
        tui_msg=""
        tui_key_action "$TUI_KEY"
        case $tui_action in
            up|down|top|bottom|pgup|pgdn)
                tui_move
                ;;
            toggle)
                tui_toggle
                ;;
            open)
                tui_toggle_open
                ;;
            unlink)
                tui_mark_remove
                ;;
            all)
                tui_set_all 1
                ;;
            none)
                tui_set_all 0
                ;;
            redraw)
                printf '%s' "$t_clear" >&"$TUI_OUT"
                ;;
            quit)
                tui_quit_prompt
                case $tui_answer in
                    save)
                        tui_result=save
                        return 0
                        ;;
                    exit)
                        tui_result="exit"
                        return 0
                        ;;
                esac
                ;;
        esac
    done
}

tui_open () {
    tui_owns_fd=0
    if [[ $tui_dev_tty == 1 ]]; then
        exec {TUI_IN}<> /dev/tty || return 1
        TUI_OUT=$TUI_IN
        tui_owns_fd=1
    elif [[ -t 0 ]] && [[ -t 1 ]]; then
        TUI_IN=0
        TUI_OUT=1
    else
        return 1
    fi
    tui_open_flag=1
    tui_saved_stty=$(stty -g <&"$TUI_IN" 2> /dev/null) || tui_saved_stty=""
    # Raw enough to get a keystroke at a time with nothing echoed; bash's
    # read -N would do most of this per call, but not between calls.
    stty -echo -icanon min 1 time 0 <&"$TUI_IN" 2> /dev/null
    tui_saved_int=$(trap -p INT)
    tui_saved_term=$(trap -p TERM)
    tui_saved_winch=$(trap -p WINCH)
    trap 'tui_abort' INT TERM
    trap 'tui_resized=1' WINCH
    printf '%s%s%s' "$t_smcup" "$t_civis" "$t_clear" >&"$TUI_OUT"
    return 0
}

tui_close () {
    if [[ $tui_open_flag != 1 ]]; then
        return 0
    fi
    tui_open_flag=0
    printf '%s%s%s' "$t_sgr0" "$t_cnorm" "$t_rmcup" >&"$TUI_OUT"
    if [[ -n $tui_saved_stty ]]; then
        stty "$tui_saved_stty" <&"$TUI_IN" 2> /dev/null
    fi
    # Only a fd this opened is ours to close; stdin and stdout are not.
    if [[ $tui_owns_fd == 1 ]]; then
        exec {TUI_IN}>&-
        tui_owns_fd=0
    fi
    TUI_IN=0
    TUI_OUT=1
    trap - INT TERM WINCH
    if [[ -n $tui_saved_int ]]; then eval "$tui_saved_int"; fi
    if [[ -n $tui_saved_term ]]; then eval "$tui_saved_term"; fi
    if [[ -n $tui_saved_winch ]]; then eval "$tui_saved_winch"; fi
}

# Ctrl-C means "I did not choose anything": leave the list empty rather than
# leaving whatever was on screen to be downloaded.
tui_abort () {
    tui_close
    : > "$listfile"
    echo "alftp: interrupted, nothing selected." >&2
    exit 130
}

# Write the selection back for TYPE to read: one line per node that says
# something, marked "+" download, "-" unlink, "*" a directory whose selection
# is on the lines below it, "#" not wanted. A path below the top level carries
# its own trailing "/" when it is a directory.
tui_save () {
    tui_pathw=0
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( ${#TUI_PATH[tui_id]} > tui_pathw )); then
            tui_pathw=${#TUI_PATH[tui_id]}
        fi
    done
    tui_scratch=$(mktemp "${TMPDIR:-/tmp}/alftp.sel.XXXXXX")
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( TUI_DEPTH[tui_id] > 0 )) && (( TUI_STATE[tui_id] == 0 )) \
           && (( TUI_SELCNT[tui_id] == 0 )); then
            continue
        fi
        case ${TUI_STATE[tui_id]} in
            2) tui_mark="-" ;;
            1) tui_mark="+" ;;
            *)
                if (( TUI_SELCNT[tui_id] > 0 )); then
                    tui_mark="*"
                else
                    tui_mark="#"
                fi
                ;;
        esac
        if [[ -z ${TUI_DATE[tui_id]} ]]; then
            printf '%s%s\n' "$tui_mark" "${TUI_PATH[tui_id]}"
        else
            printf '%s%-*s  %*s  %s\n' "$tui_mark" "$tui_pathw" "${TUI_PATH[tui_id]}" \
                "$tui_sizew" "${TUI_SIZE[tui_id]}" "${TUI_DATE[tui_id]}"
        fi
    done > "$tui_scratch" && mv "$tui_scratch" "$listfile"
    rm -f "$tui_scratch"
}

tui_select () {
    tui_cur=0
    tui_top=0
    tui_prompt=""
    tui_msg=""
    tui_resized=0
    tui_load
    if (( TUI_N == 0 )); then
        echo "alftp: the listing is empty, nothing to pick."
        return 0
    fi
    if ! tui_open; then
        tui_why="cannot open the terminal"
        return 1
    fi
    tui_size
    tui_loop
    tui_close
    if [[ $tui_result == save ]]; then
        tui_save
        if (( tui_nrm > 0 )); then
            echo "alftp: saved $tui_nsel selection(s) and $tui_nrm unlink(s) to $listfile."
        else
            echo "alftp: saved $tui_nsel selection(s) to $listfile."
        fi
    else
        : > "$listfile"
        echo "alftp: nothing selected."
    fi
    return 0
}

# Hand the listing to whichever picker is in play. Both leave $listfile in the
# same state -- wanted lines uncommented, the rest commented out -- which is
# all TYPE reads back.
pick_list () {
    if tui_usable && tui_select; then
        return 0
    fi
    if [[ $picker == tui ]]; then
        echo "alftp: using \$editor instead of the terminal UI ($tui_why)." >&2
    fi
    # The editor convention is the inverse of the UI's: with -i every entry is
    # commented out for the user to uncomment what they want.
    if [[ $ind_files == True ]]; then
        sed -i 's/^\([^#]\)/#\1/g' "$listfile"
    fi
    $editor "$listfile"
}

# Let the user pick entries out of the listing. Shared by both paths: in the
# single-session path this runs inside the lftp session, via EMIT_DL.
EDIT_LIST () {
    FORMAT_LIST
    if [[ $all_files == True ]]; then
        if [[ $quiet != True ]]; then
            pick_list
        fi
    elif [[ $ind_files == True ]]; then
        pick_list
    fi
}

POST_PROCESS () {
    if [[ $dry_run == True ]]; then
        return 0
    fi
    # Downloaded content lands under $local_dl_dir, and the SsS sentinel
    # stands in for a trailing space in the name.
    while read -r line; do
        if [[ -z $line ]]; then
            continue
        fi
        line=$(echo "$line" | sed 's|SsS$| |')
        if [[ -e "$local_dl_dir/$line" ]]; then
            chmod 644 "$local_dl_dir/$line"
        fi
    done <<< "$LINESF"
    while read -r line; do
        if [[ -z $line ]]; then
            continue
        fi
        line=$(echo "$line" | sed 's|SsS$| |')
        target="$local_dl_dir/$line"
        if [[ ! -e $target ]]; then
            continue
        fi
        if [[ -z $nounrar ]]; then
            UNRAR_FUN "$target"
        fi
        find "$target" -type d -exec chmod 777 {} \;
        find "$target" -type f -exec chmod 644  {} \;
    done <<< "$LINESD"
}

# Inverse of FORMAT_LIST, on stdin: remove the trailing "  size  date time"
# columns (and the padding in front of them) so only the filename is left.
# The size column is empty for directories, hence the optional group.
strip_columns () {
    sed -E 's/[[:space:]]{2,}([^[:space:]]+[[:space:]]+)?[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}[[:space:]]*$//'
}

#DETERMINE IF COMMNET, FILE, DIRECTORY
# Reads the picked list into three: directories to mirror, files to pget, and
# entries whose source symlink is to be removed. The leading character says
# which -- "+" download, "-" unlink, "#"/"*" leave alone -- and a line with no
# marker at all is a download, which is what hand-editing the file produces.
TYPE () {
        LIST=$(awk '
            {
                line = $0
                if (line ~ /^[#*]/) { next }
                if (line ~ /^[ \t]*$/) { next }
                act = "get"
                if (substr(line, 1, 1) == "-") { act = "rm"; line = substr(line, 2) }
                else if (substr(line, 1, 1) == "+") { line = substr(line, 2) }
                print act "\t" line
            }
        ' "$listfile" | strip_columns | sed 's|@$||')
        LIST2=$(cat "$listfile2" 2> /dev/null) || LIST2=""

        while IFS=$'\t' read -r act line; do
            if [[ -z $line ]]; then
                continue
            fi
            if [[ $act == rm ]]; then
                # The name of the symlink to drop, without the "/" the listing
                # puts on a directory.
                add_line LINESR "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                continue
            fi
            # Anything below the top level was never in $listfile2 to be looked
            # up, so its path carries its own type: a trailing "/" is a
            # directory. The path is kept whole, which is what puts the
            # download under the same structure it has on the server.
            if [[ ${line%/} == */* ]]; then
                if [[ $line == */ ]]; then
                    add_line LINESD "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                else
                    add_line LINESF "$(echo "$line" | sed 's|\s$|&SsS|')"
                fi
                continue
            fi
	    # XXX
            lined=$(echo "$LIST2" | grep -F "$line" | grep -e "/$" | sed 's|/$||' | sed 's|\s$|&SsS|') # last portion, handle trailing whitespace
            linef=$(echo "$LIST2" | grep -F "$line" | grep -v -e "/$" | grep -v -e "^$" | sed 's|\s$|&SsS|')

            add_line LINESD "$lined"
            add_line LINESF "$linef"
        done <<< "$LIST"
}

# Append to one of the newline-separated LINES* strings, skipping empties.
# (Plain concatenation, not echo -e, so a backslash in a name survives.)
add_line () {
    if [[ -z $2 ]]; then
        return 0
    fi
    if [[ -z ${!1} ]]; then
        printf -v "$1" '%s' "$2"
    else
        printf -v "$1" '%s\n%s' "${!1}" "$2"
    fi
}

#INITIATE SESSION AND DOWNLOAD
DOWNLD () {
scriptfile=$(mktemp "${TMPDIR:-/tmp}/alftp.dl.XXXXXX")
#DO NOT INDENT CONTENTS
cat > "$scriptfile" << EOF
$(open_cmd)
cd "$remote_dl_dir"
$(set_opts)
$(DLDR)
$(DLFL)
$(DLRM)
EOF
run_lftp_script "$scriptfile"
}

set_opts () {
	echo "set ftp:ssl-allow no"
	echo "set mirror:use-pget-n 5"
	echo "set mirror:dereference yes"
	echo "set xfer:clobber yes"
	echo "set ftp:charset utf-8"
	echo "set file:charset utf-8"
	echo "set ftp:use-utf8"
	echo "set net:max-retries 3"
	echo "set net:persist-retries 3"
    echo "set net:timeout 60"
}

#set ftp:charset UTF-8
#set ftp:lang en_US
#set sftp:charset UTF-8

#DOWNLOAD DIRECTORIES
# mirror -c is what makes a run resumable: it picks a partial transfer up where
# it stopped, and skips what already matches the remote, so re-running after an
# interruption (or after picking more out of the same directory) costs only
# what is actually missing. Permissions and timestamps come across with it,
# which is the rest of what "rsync -a" means here.
DLDR () {
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |') # handle trailing whitespace
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')  # and brackets, for lftp's glob
        # A path with a directory in it came from inside an opened directory:
        # it lands under the same structure locally, and its symlink is not
        # this run's to remove -- only whole top-level entries have one.
        if [[ $rawline == */* ]]; then
            unlink_ok=""
        else
            unlink_ok=1
        fi
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "mirror -c -P5 --dry-run \"$line\" "$local_dl_dir"/"\"$line\""; !echo DRY-RUN: \"$line\""
        elif [[ $norm == True ]] || [[ -z $unlink_ok ]]; then
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" "$local_dl_dir"/"\"$line\""; !echo COMPLETE: \"$line\""
        else
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" "$local_dl_dir"/"\"$line\"" && rm -f \"$line\""
	    echo "echo "COMPLETE: \"$line\"""
        fi
    done <<< "$LINESD"
}

#DOWNLOAD FILES
# pget -c continues a part-transferred file rather than starting it again.
DLFL () {
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |') # handle trailing whitespace
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')  # and brackets, for lftp's glob
        if [[ $rawline == */* ]]; then
            unlink_ok=""
        else
            unlink_ok=1
        fi
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: pget \"$line\" -o "$local_dl_dir"/\"$line\""
        else
            # pget will not make the directory a nested file has to go in.
            if [[ $rawline == */* ]]; then
                echo "!mkdir -p $(sh_quote "$local_dl_dir/${rawline%/*}")"
            fi
            if [[ $norm == True ]] || [[ -z $unlink_ok ]]; then
                echo "pget -c -n 5 \"$line\" -o "$local_dl_dir"/\"$line\"; !echo COMPLETE: \"$line\""
            else
                echo "pget -c -n 5 \"$line\" -o "$local_dl_dir"/\"$line\" && rm -f \"$line\""
                echo "echo "COMPLETE: \"$line\"""
            fi
        fi
    done <<< "$LINESF"
}

#REMOVE SOURCE SYMLINKS
# The "-" mark in the picker: drop the symlink from the completed directory
# without downloading anything.
DLRM () {
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |')
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')
        if [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: rm \"$line\""
        else
            echo "rm -f \"$line\"; !echo UNLINKED: \"$line\""
        fi
    done <<< "$LINESR"
}

COMPLETE () {
    if [[ -n $exitflag ]]; then
	    return 0
    fi
    rm -f /tmp/alftp.lock
    trap - SIGINT SIGTERM
    if [[ $rm_list == True ]]; then
        rm -f "$listfile"
    fi
    if [[ $suspend_old == True ]]; then
        mv "$oldfile" "$listfile"
    fi
}


function chkrmd () {
    if [[ -d $1 ]]; then
        rm -rf "${1:?}/"
    fi
}

function chkrmf () {
    if [[ -e $1 ]] && [[ ! -z $(ls $1) ]]; then
        rm "$1"
    fi
}

UNRAR_FUN () {
    pdir="$1"
    ext='*.rar'
    cdir=$(find "$pdir" -name "$ext" -exec dirname {} + | sort -u)
    if [[ -z $cdir ]]; then
        return 0
    fi
    while read -r line; do
        cd "$line" && \
        unrar e -n -r -or "$line" && sleep 1 && \
        find "$line" -type f \( -regex ".*.rar$" -o -regex '.*.r[0-9]+$' \) -exec rm {} +
        find "$line" -type f \( -name "*.sfv" -o -name "*.nfo" \) -exec rm {} +
        find "$line" -type d -iname "sample" -exec rm -rf {} +
        find "$line" -type d -iname "screens" -exec rm -rf {} +
        find "$line" -type d -empty -delete

    done <<< "$cdir"
}

############################################################
# Sourcing with ALFTP_LIB set loads the functions without running anything,
# which is how tests/alftp.bats exercises the parsing stages.
if [[ -z ${ALFTP_LIB:-} ]]; then
    MAIN "$@"
fi
