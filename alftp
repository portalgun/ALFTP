################################################################################
MAIN () {
    ARGV=("$@")
    # Re-entry from the in-session helper (see SINGLE_SESSION): argv arrives in
    # a NUL-delimited file so that nothing has to survive a round trip through
    # the user's $SHELL, and re-parsing it reproduces this session's globals
    # exactly -- they are all derived from the config plus argv.
    if [[ -n ${ALFTP_ARGV:-} ]]; then
        load_argv "$ALFTP_ARGV"
        set -- "${ARGV[@]}"
    fi
    resolve_self

    INIT
    ARGSA "$@" #PRIORITY FLAGS
    eval_local_config
    eval_remote_config
    # After both config passes (either of which may name the gpg file) but
    # before the argument passes, so a flag still beats an encrypted setting.
    eval_gpg_config
    ARGSB "$@" #CONFIG FLAGS
    ARGSC "$@" #OTHER FLAGS

    WELCOME
    if [[ -n ${ALFTP_EMIT_DL:-} ]]; then
        EMIT_DL
        return 0
    fi
    NEW_SESSION
    COMPLETE
}

load_argv () {
    ARGV=()
    mapfile -t -d '' ARGV < "$1"
}

# The "!" helper line has to name this script by an absolute path: lftp runs it
# through $SHELL from an unknown working directory.
resolve_self () {
    self=$(command -v -- "$0" 2>/dev/null) || self="$0"
    if [[ $self != /* ]]; then
        self="$PWD/${self#./}"
    fi
}
################################################################################
INIT () {
    if [[ ! -f $config ]]; then
        echo "Config doesn't exist."
        flag=""
        while true; do
            if [[ -z $flag ]]; then
                read -p "Create config at $config? [y/n]: " -n1 opt
            else
                read -n1 opt
            fi
            case $opt in
                y|Y)
                    if ! mkdir -p "$(dirname "$config")"; then
                        echo "Could not create $(dirname "$config")." >&2
                        exit 1
                    fi
                    printf '%s' "$config_template" > "$config"
                    break
                    ;;
                n|N)
                    break
            esac
            flag=1
        done
        flag=""
        echo "Fill in options in config file, then run again."
        exit 0
    fi
    source "$config"
    USER=$(whoami)
}

#flags that ignore others
ARGSA () {
    for i in "$@"; do
        case "$i" in
            -h|--help|help)
                printf '%s\n' "$help"
                exit 0
                ;;
            --showc|showc)
                printf '%s\n' "$copyright"
                exit 0
                ;;
            --showw|showw)
                printf '%s\n' "$warranty"
                exit 0
                ;;
        esac
    done
}

# Escape ERE metacharacters so hostnames/server names containing '.', '-' etc.
# match literally. Backslashes are doubled because awk -v processes escape
# sequences in the value it is handed.
ere_escape () {
    printf '%s' "$1" | sed 's/[][\.^$*+?(){}|]/\\\\&/g'
}

# A profile name becomes part of a variable name (dl_dir_<profile>), so map
# anything that is not valid in an identifier to '_': profile "tv-shows" is
# configured as dl_dir_tv_shows.
profile_var_name () {
    printf '%s' "${1//[^A-Za-z0-9_]/_}"
}

eval_local_config () {
    I=$(ere_escape "$(hostname)")'\\|*[A-Za-z0-9._]*\\]'
    local_config=$(awk -v awkvar="$I" 'BEGIN { RS="\n\n\\[" ; FS="\n"; OFS="\n"} $1 ~ awkvar {$1=""; print $0}' "$configsrc" | \
	grep -vE "^(port|user|dataDir|watchDir|completeDir|pass|srcs)" | \
	sed -e 's/^dl_dir=/local_dl_dir=/' -e 's/^dl_dir_/local_dl_dir_/' \
    )
    eval "$local_config"
}

eval_remote_config () {
    #I='srcs *=.*'"$i"

    def=$(grep -E '^[[:space:]]*default_server=' "$configsrc" | tail -n 1)
    if [[ -n $def ]]; then
        eval "$def"
    fi
    if [[ -n $default_server ]]; then
        I='\\|'"$(ere_escape "$default_server")"'\\]'
    fi
    remote_block=$(awk -v awkvar="$I" 'BEGIN { RS="\n\n\\[" ; FS="\n"; OFS="\n"} $0 ~ awkvar {print $0}' "$configsrc")
    remote_config=$(printf '%s\n' "$remote_block" | \
	grep -vE "^srcs" | \
	sed 's/^dl_dir=/remote_dl_dir=/' | \
	sed '1 s/|\(.*\)]/name=\1/'
    )
    #echo "$remote_config"
    eval "$remote_config"
    parse_srcs
}

# "srcs" is the list of source directories under $complete_dir, and it is the
# one key in a profile block that is not valid bash: the ";" separating the
# entries would end the assignment, which is why both config passes grep it out
# before eval'ing the rest. So it is read textually instead, out of the same
# block the remote settings came from.
parse_srcs () {
    SRCS=()
    srcs_line=$(printf '%s\n' "$remote_block" | grep -E '^[[:space:]]*srcs[[:space:]]*=' | tail -n 1)
    if [[ -z $srcs_line ]]; then
        return 0
    fi
    srcs_line=${srcs_line#*=}
    # A quoted value is worth accepting even though the ";" outside the quotes
    # is what makes the line un-eval-able in the first place.
    srcs_line=${srcs_line#[\"\']}
    srcs_line=${srcs_line%[\"\']}
    while IFS= read -r srcs_item; do
        srcs_item=${srcs_item#"${srcs_item%%[![:space:]]*}"}
        srcs_item=${srcs_item%"${srcs_item##*[![:space:]]}"}
        if [[ -n $srcs_item ]]; then
            SRCS+=("$srcs_item")
        fi
    done < <(printf '%s\n' "$srcs_line" | tr ';' '\n')
}

# A gpg-encrypted file of settings, so credentials need not sit in plaintext in
# alftp.conf or alftp.src.conf. Its plaintext is bash, and is eval'd exactly
# the way the rest of the config is -- typically it is one password= line.
# Anything that goes wrong here is fatal and named: silently carrying on would
# mean logging in with whatever credentials happened to be lying around.
eval_gpg_config () {
    if [[ -z $gpg_file ]]; then
        return 0
    fi
    gpg_file="${gpg_file/#\~/$HOME}"
    if [[ ! -f $gpg_file ]]; then
        echo "alftp: gpg_file \"$gpg_file\" does not exist." >&2
        exit 1
    fi
    if ! command -v gpg > /dev/null 2>&1; then
        echo "alftp: gpg is not installed, so gpg_file \"$gpg_file\" cannot be read." >&2
        exit 1
    fi
    # --batch keeps gpg from taking the terminal away from us; a key that needs
    # a passphrase has to come from the agent (or a pinentry gpg can drive).
    if ! gpg_plain=$(gpg --batch --quiet --decrypt "$gpg_file" 2> /dev/null); then
        echo "alftp: could not decrypt gpg_file \"$gpg_file\"." >&2
        exit 1
    fi
    eval "$gpg_plain"
    gpg_plain=""
}

ARGSB () {
    for i in "$@"; do
        if [ ! -z "$nextParam" ]; then
            case "$i" in
                -*)
                    nextParam=""
                    #echo "Missing field for "$lastParam" or incorrect syntax for "$i""
                    #exit 0
                    ;;
            esac
            case "$nextParam" in
                [ia])
		    # Kept for the record/errors logs, which say which profile a
		    # line came from.
		    profile="$i"
		    profilevar=$(profile_var_name "$i")

		    # dl_dir_<profile> (renamed to local_dl_dir_<profile> when the
		    # config is eval'd) beats the general dl_dir for this profile.
		    # @profile is still substituted afterwards, so the override may
		    # use it too.
		    override="local_dl_dir_$profilevar"
		    if [[ -n ${!override:-} ]]; then
			local_dl_dir="${!override}"
		    fi
		    local_dl_dir=$(echo "$local_dl_dir" | sed "s/@profile/$i/g")
                    destflag=1

		    # Picking a profile settles both ends: an explicit
		    # remote_dl_dir_<profile>, the profile's own remote_dl_dir, or
		    # the profile name if it has neither.
		    override="remote_dl_dir_$profilevar"
		    if [[ -n ${!override:-} ]]; then
			remote_dl_dir="${!override}"
		    fi
		    if [[ -z $remote_dl_dir ]]; then
			remote_dl_dir="$i"
		    fi
		    sourceflag=1

                    ;;
            esac
        fi
        case "$i" in
            -a)
                all_files=True
                nextParam="a"
                ;;
            -i)
                ind_files=True
                nextParam="i"
                ;;
        esac
    done
    # "-i" with nothing after it (end of argv, or another flag next, which the
    # loop above turns back into an empty nextParam) names no profile, so
    # there is nothing to build a remote directory out of. With a "srcs" list
    # to go on that is the request to pick from $complete_dir itself, one
    # level up, with those source directories as the top of the tree; without
    # one it is the usual missing-argument error, left to ARGSC to report.
    if [[ $ind_files == True ]] && [[ -z $profile ]] && [[ ${#SRCS[@]} -gt 0 ]]; then
        srcs_mode=True
    fi
}

ARGSC () {
    nextParam=""
    for i in "$@"; do
        if [ ! -z "$nextParam" ]; then
            case "$i" in
                -*)
                    echo "Missing field for "$lastParam" or incorrect syntax for "$i""
                    exit 0
                    ;;
            esac
            case "$nextParam" in
                l)
                    listfile="$i"
                    ;;
                ld)
                    local_dl_dir="$i"
                    ;;
                p)
                    password="$i"
                    ;;
                P)
                    port="$i"
                    ;;
                rd)
                    remote_dl_dir="$i"
                    ;;
                s)
                    server="$i"
                    ;;
                u)
                    username="$i"
                    ;;
            esac
            nextParam=""
            lastParam=""
            continue
        fi

        case "$i" in
            -q)
                quiet=True
                ;;
            -u)
                lastParam="$i"
                nextParam="u"
                ;;
            -p)
                lastParam="$i"
                nextParam="p"
                ;;
            -P)
                lastParam="$i"
                nextParam="P"
                ;;
            -s)
                lastParam="$i"
                nextParam="s"
                ;;

            -ld)
                lastParam="$i"
                nextParam="ld"
                destflag=1
                ;;
            -rd)
                lastParam="$i"
                nextParam="rd"
                sourceflag=1
                ;;
            -l)
                lastParam="$i"
                nextParam="l"
                ;;
            -ns)
                suspend_old=True
                ;;
            -c|--continue)
                continue_prev=True
                ;;
            -ls)
                print_ls=True
                ;;
            -jl)
                just_login=True
                return 0
                ;;
            -rl)
                rm_list=True
                ;;
            -rm)
                rm_remote=True
                ;;
            -r)
                no_append=True
                ;;
            -cl)
                clean=True
                ;;
            -d)
                data=True
                ;;
            -do)
                norm=True
                ;;
            -nu)
                nounrar=True
                ;;
            -dr|--dry-run)
                dry_run=True
                ;;
            -ds|--dir-sizes)
                dir_sizes=True
                ;;
            -t|--tui)
                picker=tui
                ;;
            -e|--editor)
                picker=editor
                ;;
            --two-session)
                two_session=True
                ;;
        esac
    done
    # In srcs mode neither end is a single directory: the source is
    # $complete_dir itself (remote_dl_dir stays empty, so the join below leaves
    # it at that) and each entry picks its own destination through
    # local_dir_for. Anything given explicitly still wins.
    if [[ -z $destflag ]] && [[ $srcs_mode != True ]]; then
        echo "Please specify desitnation."
        exit 0
    fi
    if [[ -z $sourceflag ]] && [[ $srcs_mode != True ]]; then
        echo "Please specify source."
        exit 0
    fi
    dirname="$remote_dl_dir"

    if [[ -z $complete_dir ]] && [[ ! -z $data_dir ]]; then
        data=True
    fi
    if [[ ${data,,} == true ]]; then
        remote_dl_dir="$data_dir""$remote_dl_dir"
    else
        remote_dl_dir="$complete_dir""$remote_dl_dir"
    fi
}
############################################################

# Every temp file the run creates goes through here, so that a signal can take
# them all back again (see cleanup_run). The name comes back in $tmpfile_new
# rather than on stdout because a $(...) would put the append in a subshell,
# where the array would not survive.
new_tmp () {
    tmpfile_new=$(mktemp "$1") || return 1
    tmpfiles+=("$tmpfile_new")
}

# One run at a time: two of them share $listfile and would pick each other's
# selections apart. The pid in the file is what tells a live holder from one
# that was killed before it could clean up.
take_lock () {
    if [[ -z $lockfile ]]; then
        return 0
    fi
    # noclobber makes the create-if-absent atomic, so two runs starting at once
    # cannot both decide the lock is free.
    if ( set -o noclobber; printf '%s\n' "$$" > "$lockfile" ) 2> /dev/null; then
        lock_held=1
        return 0
    fi
    lockpid=$(head -n 1 "$lockfile" 2> /dev/null) || lockpid=""
    if [[ $lockpid =~ ^[0-9]+$ ]] && kill -0 "$lockpid" 2> /dev/null; then
        echo "alftp: another run (pid $lockpid) is in progress; $lockfile is held." >&2
        echo "Wait for it to finish, or remove $lockfile if it is not." >&2
        exit 1
    fi
    echo "alftp: ignoring stale lock $lockfile (pid ${lockpid:-unknown} is gone)." >&2
    rm -f "$lockfile"
    if ! ( set -o noclobber; printf '%s\n' "$$" > "$lockfile" ) 2> /dev/null; then
        echo "alftp: cannot create lock file \"$lockfile\"." >&2
        exit 1
    fi
    lock_held=1
}

# Only the run that took the lock removes it: the in-session helper re-enters
# MAIN with the parent's lock already in place and must leave it alone.
release_lock () {
    if [[ -n $lock_held ]] && [[ -n $lockfile ]]; then
        rm -f "$lockfile"
        lock_held=""
    fi
}

# What an interrupted run has to take back with it. The temp files are kept
# when ALFTP_DEBUG asked for them, the same way a failed lftp session keeps its
# script.
cleanup_run () {
    release_lock
    if [[ -z ${ALFTP_DEBUG:-} ]] && [[ ${#tmpfiles[@]} -gt 0 ]]; then
        rm -f "${tmpfiles[@]}"
    fi
}

# Clean up, then die of the signal we caught rather than of exit 0, so whatever
# ran alftp sees an interrupted process. COMPLETE clears these again.
on_signal () {
    trap - INT TERM HUP
    echo
    echo "alftp: interrupted (SIG$1), cleaning up." >&2
    cleanup_run
    kill -"$1" $$
}

install_traps () {
    trap 'on_signal INT' INT
    trap 'on_signal TERM' TERM
    trap 'on_signal HUP' HUP
}

# The config in the wild spells this keyFile; the script has always read
# keyfile. Take whichever one was set, preferring the documented spelling.
resolve_keyfile () {
    if [[ -z $keyfile ]] && [[ -n $keyFile ]]; then
        keyfile="$keyFile"
    fi
}

# Fail early, and by name, rather than letting lftp report something cryptic.
validate_config () {
    missing=""
    if [[ -z $server ]]; then missing="$missing server"; fi
    if [[ -z $username ]]; then missing="$missing username"; fi
    if [[ -z $port ]]; then missing="$missing port"; fi
    if [[ -n $missing ]]; then
        echo "alftp: missing required setting(s):$missing" >&2
        echo "Set them in $config or $configsrc, or pass -s/-u/-P." >&2
        exit 1
    fi
}

# A password that is neither configured nor in the gpg file, with no key to
# fall back on, is worth asking for rather than failing on -- but only when
# there is somebody there to ask. Without a terminal (cron, a redirected run)
# the empty password stands, which is also what an anonymous server wants.
prompt_password () {
    if [[ -n $password ]] || [[ -n $keyfile ]] || [[ -z $username ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        return 0
    fi
    read -r -s -p "Password for $username@$server: " password
    echo
    if [[ -n $password ]]; then
        password_prompted=1
    fi
}

WELCOME () {
if [[ -z $(command -v lftp) ]]; then
    echo "lftp is not installed."
    exit 1
fi
resolve_keyfile
# The in-session helper is this same script re-entered from inside the lftp
# session (see SINGLE_SESSION): the run's lock is already held by the parent,
# and the password it was asked for came down in the environment rather than
# being asked for a second time in the middle of the session.
if [[ -n ${ALFTP_EMIT_DL:-} ]]; then
    if [[ -n ${ALFTP_PASSWORD:-} ]]; then
        password="$ALFTP_PASSWORD"
    fi
else
    validate_config
    prompt_password
    if [[ -z $lockfile ]]; then
        lockfile=/tmp/alftp.lock
    fi
    install_traps
    take_lock
fi
if [[ -z $listfile ]]; then
    listfile="$HOME/.cache/alftp/alftp.list"
fi
if [[ -z $logfile ]]; then
    logfile="$HOME/.cache/alftp/alftp.log"
fi
if [[ -z $record ]]; then
    record="$HOME/.cache/alftp/alftp.record"
fi
if [[ -z $errors ]]; then
    errors="$HOME/.cache/alftp/alftp.errors"
fi
if [[ -z $verify ]]; then
    verify="$HOME/.cache/alftp/alftp.verify"
fi
if ! mkdir -p "$(dirname "$listfile")" "$(dirname "$logfile")" \
              "$(dirname "$record")" "$(dirname "$errors")" "$(dirname "$verify")"; then
    echo "alftp: cannot create directory for listfile/logfile." >&2
    exit 1
fi
if ! touch "$listfile"; then
    echo "alftp: cannot write listfile \"$listfile\"." >&2
    exit 1
fi
# Derived here so the parent and the in-session helper agree on them -- the
# helper never runs the session functions that would otherwise name them.
listfile2="$listfile"2
listfile3="$listfile"3
listfile4="$listfile"4
listfile5="$listfile"5
oldfile="$listfile"_old
}

# Quote a value for lftp's own (shell-like) command parser.
lftp_quote () {
    quoted=$1
    quoted=${quoted//\\/\\\\}
    quoted=${quoted//\"/\\\"}
    printf '"%s"' "$quoted"
}

# Quote a value for the $SHELL that lftp's "!" command hands the line to.
sh_quote () {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

# The credentials live in the (0600, mktemp'd) script rather than on lftp's
# command line, so they no longer show up in ps output.
open_cmd () {
    printf 'open'
    if [[ -n $username ]]; then
        printf ' --user %s --password %s' \
            "$(lftp_quote "$username")" "$(lftp_quote "$password")"
    fi
    if [[ -n $port ]]; then
        printf ' -p %s' "$(lftp_quote "$port")"
    fi
    printf ' %s\n' "$(lftp_quote "$server")"
}

# Every lftp session is generated into a temp script first, so that what was
# actually sent to lftp can be inspected when something goes wrong (the file is
# kept on failure, or whenever ALFTP_DEBUG is set) instead of only existing
# inside a here-doc. -f (rather than stdin) is what lets the session shell out
# to an interactive editor: the helper it spawns inherits lftp's stdin, which
# is still the terminal.
run_lftp_script () {
    scriptfile="$1"
    rc=0
    if [[ -n ${ALFTP_DEBUG:-} ]]; then
        echo "alftp: lftp commands in $scriptfile" >&2
    fi
    export LC_ALL=C.UTF-8
    lftp -f "$scriptfile" || rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "alftp: lftp exited $rc; the commands sent are in $scriptfile" >&2
    elif [[ -z ${ALFTP_DEBUG:-} ]]; then
        rm -f "$scriptfile"
    fi
    return $rc
}

# The remote listing has no size for directories, so with -ds we ask lftp for
# one. This walks the whole tree below $remote_dl_dir (one listing per
# subdirectory), which is why it is opt-in rather than always on. Prints
# nothing when the flag is off, so the line simply vanishes from the script.
du_cmd () {
    if [[ $dir_sizes == True ]]; then
        printf 'du -h --max-depth=1 . > %s\n' "$(lftp_quote "$listfile3")"
    fi
}

# The completed directory listed a second time, long form, which is the only
# thing that says where each symlink points (see the SYMLINKS section). Prints
# nothing when there is nowhere to put it, the way du_cmd does.
ls_l_cmd () {
    if [[ -n $listfile4 ]]; then
        printf 'ls -l > %s\n' "$(lftp_quote "$listfile4")"
    fi
}

# The data directory listed with its sizes, which is the only place a real one
# is to be had: in the completed directory the size column is the length of the
# *symlink*, not of what it points at. --size on its own reports 1 for
# everything, so -h is not cosmetic here -- it is what makes lftp print a
# figure at all, at the cost of it being rounded ("4.1G"). Prints nothing when
# there is nowhere to put it, the way du_cmd does.
size_cmd () {
    if [[ -n $listfile5 ]]; then
        printf 'cls -1 -F -h --size > %s\n' "$(lftp_quote "$listfile5")"
    fi
}

CREATE_LIST () {
    # Last run's list, marks and all, is what -c carries into this one; the
    # listing below is about to overwrite it.
    cp "$listfile" "$oldfile"

    new_tmp "${TMPDIR:-/tmp}/alftp.list.XXXXXX"; scriptfile="$tmpfile_new"
    #DO NOT INDENT CONTENTS
    cat > "$scriptfile" << EOF
$(open_cmd)
$(set_opts)
cd "$remote_dl_dir"
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > "$listfile"
$(ls_l_cmd)
$(du_cmd)
cd "$data_dir""$dirname"
cls -1 > "$listfile2"
$(size_cmd)
quit
EOF
    run_lftp_script "$scriptfile"
}

# Listing, file selection and download in one login. lftp lists into
# $listfile, shells out to this same script (which runs the editor and turns
# the selection into mirror/pget commands), then sources what it wrote -- so
# the connection opened for the listing is the one that does the transfer.
SINGLE_SESSION () {
    cp "$listfile" "$oldfile"

    new_tmp "${TMPDIR:-/tmp}/alftp.emit.XXXXXX"; emitfile="$tmpfile_new"
    new_tmp "${TMPDIR:-/tmp}/alftp.argv.XXXXXX"; argvfile="$tmpfile_new"
    if [[ ${#ARGV[@]} -gt 0 ]]; then
        printf '%s\0' "${ARGV[@]}" > "$argvfile"
    else
        : > "$argvfile"
    fi

    new_tmp "${TMPDIR:-/tmp}/alftp.session.XXXXXX"; scriptfile="$tmpfile_new"
    #DO NOT INDENT CONTENTS
    cat > "$scriptfile" << EOF
$(open_cmd)
set net:idle never
$(set_opts)
cd "$remote_dl_dir"
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > "$listfile"
$(ls_l_cmd)
$(du_cmd)
cd "$data_dir""$dirname"
cls -1 > "$listfile2"
$(size_cmd)
cd "$remote_dl_dir"
!env $(child_env) bash $(sh_quote "$self")
source "$emitfile"
quit
EOF
    run_lftp_script "$scriptfile"
    rc=$?
    if [[ -n ${ALFTP_DEBUG:-} ]]; then
        echo "alftp: download commands in $emitfile, argv in $argvfile" >&2
    else
        rm -f "$emitfile" "$argvfile"
    fi
    return $rc
}

# What the "!" line hands the helper. Everything else it re-derives from the
# config and argv, but a password that was typed at a prompt is not in either --
# and the helper needs it for the listing logins that tab does. A child's
# environment is readable only by its owner, and the script this line lives in
# already holds the same secret.
child_env () {
    printf 'ALFTP_EMIT_DL=%s ALFTP_ARGV=%s' \
        "$(sh_quote "$emitfile")" "$(sh_quote "$argvfile")"
    if [[ -n $password_prompted ]]; then
        printf ' ALFTP_PASSWORD=%s' "$(sh_quote "$password")"
    fi
}

# Runs inside the lftp session, spawned by the "!" line above.
# The broken-link removals go first: they are housekeeping the user did not ask
# for and did not select, and a run interrupted halfway through a long transfer
# should still have done them.
EMIT_DL () {
    EDIT_LIST
    # -ls is answered by the parent, from the same list file this just saved,
    # so the session finds nothing to source and transfers nothing.
    if [[ $print_ls == True ]]; then
        : > "$ALFTP_EMIT_DL"
        return 0
    fi
    TYPE
    { DLPRUNE; DLXFER; DLRM; DLDEL; } > "$ALFTP_EMIT_DL"
}

NEW_SESSION () {
    if [[ $just_login == True ]]; then
	# Interactive session, so the open command (and with it the credentials)
	# comes from a temp rc file instead of the command line, keeping the
	# password out of ps output like the generated sessions do.
	new_tmp "${TMPDIR:-/tmp}/alftp.open.XXXXXX"; openrc="$tmpfile_new"
	open_cmd > "$openrc"
	lftp --rcfile "$openrc"
	rm -f "$openrc"
	exitflag=True
    else
        if [[ $two_session == True ]]; then
            CREATE_LIST
            EDIT_LIST
            if [[ $print_ls == True ]]; then
                LIST_MARKED
            else
                TYPE
                if [[ ! -z $LINESF ]] || [[ ! -z $LINESD ]] || [[ ! -z $LINESR ]] \
                   || [[ ! -z $LINESB ]] || [[ ! -z $LINESX ]]; then
                    DOWNLD
                    POST_PROCESS
                fi
            fi
        else
            SINGLE_SESSION
            # The selection was made by the helper inside the session; re-run
            # TYPE here against the same (edited) list to recover what was
            # downloaded, so post-processing knows what to work on.
            if [[ $print_ls == True ]]; then
                LIST_MARKED
            else
                TYPE
                POST_PROCESS
            fi
        fi
        rm -f "$listfile2" "$listfile3" "$listfile4" "$listfile5"
    fi
}

# Turn the raw "size date time name" listing lftp writes into the columnar
# form the user edits: name first, then size, then date, padded so the columns
# line up. Only the name is meaningful when the file is read back (see TYPE),
# the other columns are there to inform the selection. Lines that do not look
# like a listing entry (a server that omits the date, say) are passed through
# untouched, so nothing is ever dropped from the list.
# The awk that does it, factored out so the picker can put a freshly fetched
# subdirectory listing through the same transformation ($2 is the du file, or
# empty when there is none).
format_columns () {
    awk -v dufile="$2" '
        # With -ds, $listfile3 holds "size<TAB>./name" for every directory
        # (plus a grand total for "."), which fills the size column the
        # listing leaves empty.
        BEGIN {
            while (dufile != "" && (getline duline < dufile) > 0) {
                tab = index(duline, "\t")
                if (tab == 0) { continue }
                duname = substr(duline, tab + 1)
                sub(/^\.\//, "", duname)
                sub(/\/+$/, "", duname)
                if (duname == "" || duname == ".") { continue }
                dusize[duname] = substr(duline, 1, tab - 1)
            }
            if (dufile != "") { close(dufile) }
        }
        {
            line[NR] = $0
            # "size date time name" (files) and, for directories, which lftp
            # lists without a size, "date time name".
            if (match($0, /^[ \t]*[^ \t]+[ \t]+[0-9][0-9-]+ [0-9][0-9:]+ /)) {
                head = substr($0, 1, RLENGTH)
                name[NR] = substr($0, RLENGTH + 1)
                sub(/^[ \t]+/, "", head)
                split(head, f, / +/)
                size[NR] = f[1]
                date[NR] = f[2] " " f[3]
            } else if (match($0, /^[ \t]*[0-9][0-9-]+ [0-9][0-9:]+ /)) {
                head = substr($0, 1, RLENGTH)
                name[NR] = substr($0, RLENGTH + 1)
                sub(/^[ \t]+/, "", head)
                split(head, f, / +/)
                size[NR] = ""
                date[NR] = f[1] " " f[2]
            }
            # cls -F marks directories with a trailing "/". Their size, when
            # the server gives one at all, is the size of the directory entry
            # rather than of its contents, so du wins wherever it has an
            # answer.
            if (NR in name && name[NR] ~ /\/$/) {
                key = name[NR]
                sub(/\/$/, "", key)
                if (key in dusize) { size[NR] = dusize[key] }
            }
            if (NR in name) {
                if (length(name[NR]) > namew) { namew = length(name[NR]) }
                if (length(size[NR]) > sizew) { sizew = length(size[NR]) }
            }
        }
        END {
            for (i = 1; i <= NR; i++) {
                if (i in name) {
                    printf "%-*s  %*s  %s\n", namew, name[i], sizew, size[i], date[i]
                } else {
                    print line[i]
                }
            }
        }
    ' "$1"
}

FORMAT_LIST () {
    if [[ ! -s $listfile ]]; then
        return 0
    fi
    new_tmp "${TMPDIR:-/tmp}/alftp.fmt.XXXXXX"; tmpfile="$tmpfile_new"
    dufile=""
    if [[ -n $listfile3 ]] && [[ -s $listfile3 ]]; then
        dufile="$listfile3"
    fi
    format_columns "$listfile" "$dufile" > "$tmpfile" && mv "$tmpfile" "$listfile"
    rm -f "$tmpfile"
}

# srcs mode lists $complete_dir itself, which holds more than the source
# directories the profile named -- and the profile may name directories that
# are not there. The listing is cut down to the intersection before anything
# looks at it, so the tree, $editor and TYPE all agree on what the top level
# is. The name is recovered exactly the way PRUNE_LIST recovers it.
SRCS_FILTER () {
    if [[ $srcs_mode != True ]] || [[ ${#SRCS[@]} -eq 0 ]] || [[ ! -s $listfile ]]; then
        return 0
    fi
    new_tmp "${TMPDIR:-/tmp}/alftp.srcs.XXXXXX"; tui_srcs_keep="$tmpfile_new"
    printf '%s\n' "${SRCS[@]}" > "$tui_srcs_keep"
    new_tmp "${TMPDIR:-/tmp}/alftp.srcs.XXXXXX"; tui_srcs_out="$tmpfile_new"
    awk -v names="$tui_srcs_keep" '
        BEGIN { while ((getline nm < names) > 0) { keep[nm] = 1 } }
        {
            nm = $0
            sub(/^[-+*#]/, "", nm)
            sub(/[ \t][ \t]+([^ \t]+[ \t]+)?[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/, "", nm)
            sub(/[ \t]+$/, "", nm)
            sub(/[\/@*]$/, "", nm)
            if (nm in keep) { print }
        }
    ' "$listfile" > "$tui_srcs_out" && mv "$tui_srcs_out" "$listfile"
    rm -f "$tui_srcs_keep" "$tui_srcs_out"
}

# ----------------------------------------------------------------- SYMLINKS --
# The completed directory is symlinks into the data directory, and a directory
# that has been in use for a while collects broken ones: the data behind the
# link was removed and the link outlived it. Downloading such an entry can only
# fail, so the listing sessions capture "ls -l" into $listfile4 as well, and the
# entries are checked against $listfile2 -- the data directory's own listing --
# before the picker ever draws them.

# Parse "name -> target" out of an "ls -l" listing, one "name<TAB>target"
# record per symlink. What a server puts in front of the name is its business:
# the group column is sometimes missing, the date may be "Mon DD HH:MM",
# "Mon DD  YYYY" (ls drops the time once a file is old enough) or ISO, so the
# name is taken to be whatever follows the timestamp rather than a fixed field
# number. A line with no timestamp this recognises yields no record at all,
# which is the safe direction: an entry with no record is never checked, and an
# entry that was never checked counts as valid.
# Names and targets may both contain spaces, hence " -> " as the separator; a
# name that contains " -> " itself splits in the wrong place, and comes out as
# a name matching nothing, which again only costs a check.
link_targets () {
    awk '
        /^l[rwxsStT-]/ {
            arrow = index($0, " -> ")
            if (arrow == 0) { next }
            head = substr($0, 1, arrow - 1)
            tgt = substr($0, arrow + 4)
            if (match(head, /[ \t][A-Za-z][A-Za-z][A-Za-z][ \t]+[0-9]+[ \t]+([0-9][0-9]:[0-9][0-9]|[0-9][0-9][0-9][0-9])[ \t]+/) ||
                match(head, /[ \t][0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][ \t]+[0-9][0-9]:[0-9][0-9][ \t]+/)) {
                nm = substr(head, RSTART + RLENGTH)
            } else {
                next
            }
            if (nm == "" || tgt == "") { next }
            print nm "\t" tgt
        }
    ' "$1"
}

# Fill LINK_TARGET from the long listing. Cheap and idempotent, so call it
# wherever the map is wanted; a missing or unreadable $listfile4 just leaves it
# empty, and everything downstream treats "no target" as "not verifiable".
LOAD_LINKS () {
    unset LINK_TARGET
    declare -gA LINK_TARGET=()
    if [[ -z $listfile4 ]] || [[ ! -s $listfile4 ]]; then
        return 0
    fi
    while IFS=$'\t' read -r link_name link_tgt; do
        if [[ -n $link_name ]]; then
            LINK_TARGET[$link_name]="$link_tgt"
        fi
    done < <(link_targets "$listfile4")
}

# Fold "." and ".." out of a remote path, textually: the path names something on
# the server, so there is nothing here to resolve it against. Result in
# $link_norm, absolute exactly when the input was.
link_normalize () {
    link_norm=""
    IFS='/' read -r -a link_split <<< "$1"
    for link_part in ${link_split[@]+"${link_split[@]}"}; do
        case "$link_part" in
            ''|.)
                ;;
            ..)
                link_norm=${link_norm%/*}
                ;;
            *)
                link_norm="$link_norm/$link_part"
                ;;
        esac
    done
    if [[ $1 != /* ]]; then
        link_norm=${link_norm#/}
    fi
}

# Where the data behind entry $1 lives, as an absolute remote path, in
# $link_path. The target "ls -l" reported wins -- resolved against the completed
# directory when it is relative, which is the usual case -- and an entry with no
# parsed target falls back to the path the layout implies. The classifier cls -F
# puts on a name ("@", "/") is not part of it.
link_data_path () {
    link_key=${1%[/@*]}
    link_to=${LINK_TARGET[$link_key]:-}
    if [[ -z $link_to ]]; then
        link_normalize "$data_dir$dirname/$link_key"
    elif [[ $link_to == /* ]]; then
        link_normalize "$link_to"
    else
        link_normalize "$remote_dl_dir/$link_to"
    fi
    link_path=$link_norm
}

# The same question for a path the picker produced rather than a bare name: a
# nested path names something *inside* a symlinked release, so only its first
# component has a target to resolve -- the rest hangs off whatever that resolved
# to. Result in $link_path, as an absolute remote path.
link_entry_path () {
    if [[ ${1%/} == */* ]]; then
        link_data_path "${1%%/*}"
        link_normalize "$link_path/${1#*/}"
        link_path=$link_norm
    else
        link_data_path "$1"
    fi
}

# Take the broken symlinks out of the listing and line them up for removal
# ($LINESB, which DLPRUNE emits). A target is only ever judged against the one
# listing we have: $listfile2 covers the top level of $data_dir$dirname, so a
# target landing there is broken exactly when that listing does not have it, and
# a target pointing anywhere else -- another directory, deeper than the listing
# goes, or a line link_targets could not parse -- is left alone. "Could not be
# verified" must never read as "delete it".
# Expects LOAD_LINKS to have run; prune_broken=False turns the whole thing off.
VALIDATE_LINKS () {
    LINESB=""
    link_count=0
    link_broken=()
    if [[ ${prune_broken,,} != true ]]; then
        return 0
    fi
    if [[ ${#LINK_TARGET[@]} -eq 0 ]] || [[ -z $listfile2 ]] || [[ ! -s $listfile2 ]]; then
        return 0
    fi
    unset LINK_DATA
    declare -gA LINK_DATA=()
    while IFS= read -r link_key || [[ -n $link_key ]]; do
        if [[ -n $link_key ]]; then
            LINK_DATA[${link_key%/}]=1
        fi
    done < "$listfile2"
    link_normalize "$data_dir$dirname"
    link_datadir=$link_norm
    for link_name in "${!LINK_TARGET[@]}"; do
        link_data_path "$link_name"
        if [[ $link_path != "$link_datadir"/* ]]; then
            continue
        fi
        link_rel=${link_path#"$link_datadir"/}
        if [[ -z $link_rel ]] || [[ $link_rel == */* ]]; then
            continue
        fi
        if [[ -n ${LINK_DATA[$link_rel]:-} ]]; then
            continue
        fi
        link_broken+=("$link_name")
    done
    if [[ ${#link_broken[@]} -eq 0 ]]; then
        return 0
    fi
    link_count=${#link_broken[@]}
    link_tmp=$(mktemp "${TMPDIR:-/tmp}/alftp.broken.XXXXXX")
    printf '%s\n' "${link_broken[@]}" | sort > "$link_tmp"
    PRUNE_LIST
    while IFS= read -r link_name; do
        add_line LINESB "$(echo "$link_name" | sed 's|\s$|&SsS|')"
    done < "$link_tmp"
    rm -f "$link_tmp"
    if [[ $dry_run == True ]]; then
        echo "alftp: $link_count broken symlink(s) dropped from the list (dry run, none removed)"
    elif [[ $norm == True ]]; then
        echo "alftp: $link_count broken symlink(s) dropped from the list, left on the remote (-do)"
    else
        echo "alftp: pruning $link_count broken symlink(s) from $remote_dl_dir"
    fi
}

# Drop every line of $listfile naming one of the entries in $link_tmp. The name
# is recovered the way TYPE recovers it -- marker off the front, columns off the
# end, classifier off the name -- so this matches whether the list has been
# through the picker or not.
PRUNE_LIST () {
    link_out=$(mktemp "${TMPDIR:-/tmp}/alftp.prune.XXXXXX")
    awk -v names="$link_tmp" '
        BEGIN { while ((getline nm < names) > 0) { drop[nm] = 1 } }
        {
            nm = $0
            sub(/^[-+*#]/, "", nm)
            sub(/[ \t][ \t]+([^ \t]+[ \t]+)?[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/, "", nm)
            sub(/[ \t]+$/, "", nm)
            sub(/[\/@*]$/, "", nm)
            if (nm in drop) { next }
            print
        }
    ' "$listfile" > "$link_out" && mv "$link_out" "$listfile"
    rm -f "$link_out"
}

# ------------------------------------------------------------------- PICKER --
# The listing is picked either in $editor (the original way) or in the terminal
# UI below, which is the default wherever the terminal can drive it. There are
# no curses bindings for bash, so the UI is terminfo strings from tput written
# to whichever fds reach the terminal -- /dev/tty when there is one, stdin and
# stdout otherwise, which is what makes it work in the single-session path,
# where this code runs inside the "!" shell-out from lftp.
#
# What the user picks is a tree: Tab lists a remote directory (over a short
# lived lftp login of its own, since the session that spawned this one is
# blocked waiting for it) and its entries appear indented underneath. A node
# carries one of three states -- nothing, "+" download, "-" remove the source
# symlink -- and a directory holding a selection it does not itself have shows
# "*". Everything below is indexed by node id; TUI_ORDER is the tree flattened
# for display and TUI_VIS the part of it that open directories make visible.

# What the UI needs. Anything missing (no terminal, no terminfo, a terminal too
# small or too dumb) falls back to $editor instead of failing the run; $tui_why
# says which requirement was the problem.
tui_usable () {
    tui_why=""
    if [[ $picker == editor ]]; then
        tui_why="picker is set to editor"
        return 1
    fi
    if ! command -v tput > /dev/null 2>&1; then
        tui_why="tput (ncurses) is not installed"
        return 1
    fi
    if [[ -z ${TERM:-} ]] || [[ $TERM == dumb ]]; then
        tui_why="TERM is unset or dumb"
        return 1
    fi
    # /dev/tty is the first choice, but lftp's "!" hands its child the
    # terminal on stdin/stdout without a controlling terminal (tpgid -1), and
    # that is where this runs in the single-session path -- so stdin/stdout
    # are a perfectly good fallback, and only having neither rules the UI out.
    tui_dev_tty=0
    if ( : <> /dev/tty ) 2> /dev/null; then
        tui_dev_tty=1
    elif [[ ! -t 0 ]] || [[ ! -t 1 ]]; then
        tui_why="not attached to a terminal"
        return 1
    fi
    tui_caps
    if [[ -z $t_rev ]] || [[ -z $t_sgr0 ]]; then
        tui_why="terminfo has no reverse video for $TERM"
        return 1
    fi
    tui_size
    if (( TUI_LINES < 6 )) || (( TUI_COLS < 20 )); then
        tui_why="terminal is only ${TUI_COLS}x${TUI_LINES}"
        return 1
    fi
    return 0
}

# Every capability is looked up once: each tput is a fork, and the UI redraws
# on every keystroke. A capability the terminal lacks comes back empty, which
# is exactly what should then be printed for it.
tui_caps () {
    t_smcup=$(tput smcup 2> /dev/null)
    t_rmcup=$(tput rmcup 2> /dev/null)
    t_civis=$(tput civis 2> /dev/null)
    t_cnorm=$(tput cnorm 2> /dev/null)
    t_clear=$(tput clear 2> /dev/null)
    t_home=$(tput home 2> /dev/null)
    t_el=$(tput el 2> /dev/null)
    t_rev=$(tput rev 2> /dev/null)
    t_bold=$(tput bold 2> /dev/null)
    t_dim=$(tput dim 2> /dev/null)
    t_sgr0=$(tput sgr0 2> /dev/null)
}

# stty knows the size of the terminal even when stdout is a pipe, which tput
# does not; tput is the fallback and a sane 80x24 the fallback of last resort.
tui_size () {
    if [[ $tui_dev_tty == 1 ]]; then
        tui_scratch=$(stty size < /dev/tty 2> /dev/null) || tui_scratch=""
    else
        tui_scratch=$(stty size <&"$TUI_IN" 2> /dev/null) || tui_scratch=""
    fi
    TUI_LINES=${tui_scratch%% *}
    TUI_COLS=${tui_scratch##* }
    if [[ ! $TUI_LINES =~ ^[1-9][0-9]*$ ]]; then
        TUI_LINES=$(tput lines 2> /dev/null)
    fi
    if [[ ! $TUI_COLS =~ ^[1-9][0-9]*$ ]]; then
        TUI_COLS=$(tput cols 2> /dev/null)
    fi
    if [[ ! $TUI_LINES =~ ^[1-9][0-9]*$ ]]; then
        TUI_LINES=24
    fi
    if [[ ! $TUI_COLS =~ ^[1-9][0-9]*$ ]]; then
        TUI_COLS=80
    fi
    tui_rows_calc
}

# Rows left for the list once the title, the column header and the footer have
# had their line each.
tui_rows_calc () {
    TUI_ROWS=$(( TUI_LINES - 3 ))
    if (( TUI_ROWS < 1 )); then
        TUI_ROWS=1
    fi
}

tui_reset () {
    TUI_NAME=(); TUI_PATH=(); TUI_SIZE=(); TUI_DATE=()
    TUI_DEPTH=(); TUI_PARENT=(); TUI_ISDIR=(); TUI_OPEN=(); TUI_LOADED=()
    TUI_STATE=(); TUI_SELCNT=(); TUI_POS=()
    TUI_STATUS=(); TUI_LSTAT=(); TUI_ACC=(); TUI_HASKID=()
    TUI_LPATH=(); TUI_LHAVE=()
    TUI_ORDER=(); TUI_VIS=()
    tui_statusw=0
    tui_nodes=0; TUI_N=0; tui_nsel=0; tui_nrm=0; tui_ndel=0
}

# The classifier cls -F puts on a name ("/" for a directory, "@" for a symlink)
# is display only: it has no place in a path handed back to lftp.
tui_strip_class () {
    tui_stripped=${1%[/@*]}
}

tui_add_node () {
    tui_new_id=$tui_nodes
    tui_nodes=$(( tui_nodes + 1 ))
    TUI_NAME[tui_new_id]=$1
    TUI_SIZE[tui_new_id]=$2
    TUI_DATE[tui_new_id]=$3
    TUI_PARENT[tui_new_id]=$4
    TUI_ISDIR[tui_new_id]=$5
    TUI_STATE[tui_new_id]=0
    TUI_STATUS[tui_new_id]=""
    TUI_LSTAT[tui_new_id]=""
    TUI_ACC[tui_new_id]=""
    TUI_HASKID[tui_new_id]=0
    TUI_LPATH[tui_new_id]=""
    TUI_LHAVE[tui_new_id]=0
    TUI_SELCNT[tui_new_id]=0
    TUI_OPEN[tui_new_id]=0
    TUI_LOADED[tui_new_id]=0
    TUI_POS[tui_new_id]=0
    if (( $4 < 0 )); then
        TUI_DEPTH[tui_new_id]=0
        # Top level keeps the name exactly as the listing had it, classifier
        # and all, because TYPE resolves those against $listfile2 the way it
        # always has.
        TUI_PATH[tui_new_id]=$1
    else
        TUI_DEPTH[tui_new_id]=$(( TUI_DEPTH[$4] + 1 ))
        tui_strip_class "${TUI_PATH[$4]}"
        tui_scratch=$tui_stripped
        tui_strip_class "$1"
        # A path below the top level is the one thing TYPE cannot look up, so
        # it carries its own type: a trailing "/" means directory.
        if [[ $5 == 1 ]]; then
            TUI_PATH[tui_new_id]="$tui_scratch/$tui_stripped/"
        else
            TUI_PATH[tui_new_id]="$tui_scratch/$tui_stripped"
        fi
    fi
}

# Split a formatted listing into name/size/date records. Any marker written by
# a previous pass comes off here: a reloaded list starts deselected like any
# other.
tui_parse_listing () {
    awk '
        {
            line = $0
            sub(/^[-+*#]/, "", line)
            if (line ~ /^[ \t]*$/) { next }
            if (match(line, /[ \t][ \t]+[^ \t]*[ \t]+[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/)) {
                nm = substr(line, 1, RSTART - 1)
                n = split(substr(line, RSTART), f, /[ \t]+/)
                if (n >= 4) { sz = f[2]; dt = f[3] " " f[4] } else { sz = ""; dt = f[2] " " f[3] }
            } else {
                nm = line
                sz = ""
                dt = ""
            }
            sub(/[ \t]+$/, "", nm)
            if (nm == "" || nm == "." || nm == ".." || nm == "./" || nm == "../") { next }
            print nm "\t" sz "\t" dt
        }
    ' "$1"
}

# The size the completed directory gives a top-level entry is the length of the
# symlink, which is not a fact about the file at all, so a real figure replaces
# it in $tui_sz wherever there is one: du's recursive total for a directory,
# and the data listing's own size for a file. The data listing is no use for a
# directory -- there it gives the size of the directory entry, which says
# nothing about what is in it. The check for remote changes re-lists the same
# two directories, so it wants the same substitution.
tui_real_size () {
    if [[ -n ${TUI_DUSIZE[$1]:-} ]]; then
        tui_sz=${TUI_DUSIZE[$1]}
    elif (( $2 == 0 )) && [[ -n ${TUI_RSIZE[$1]:-} ]]; then
        tui_sz=${TUI_RSIZE[$1]}
    fi
}

# The top level of the tree. Which of those entries are directories is the same
# question TYPE asks, and it has the same answer: $listfile2, the listing of
# the real directory behind the symlinks.
tui_load () {
    tui_reset
    unset TUI_DIRMAP
    declare -gA TUI_DIRMAP=()
    if [[ -n $listfile2 ]] && [[ -s $listfile2 ]]; then
        while IFS= read -r tui_scratch || [[ -n $tui_scratch ]]; do
            if [[ $tui_scratch == */ ]]; then
                TUI_DIRMAP[${tui_scratch%/}]=1
            fi
        done < "$listfile2"
    fi
    tui_load_sizes
    while IFS=$'\t' read -r tui_nm tui_sz tui_dt; do
        tui_isdir=0
        tui_strip_class "$tui_nm"
        if [[ $tui_nm == */ ]] || [[ -n ${TUI_DIRMAP[$tui_stripped]:-} ]]; then
            tui_isdir=1
        fi
        tui_real_size "$tui_stripped" "$tui_isdir"
        tui_add_node "$tui_nm" "$tui_sz" "$tui_dt" -1 "$tui_isdir"
        TUI_ORDER+=("$tui_new_id")
    done < <(tui_parse_listing "$listfile")
    tui_reindex
    tui_status_scan
    tui_rebuild_vis
    tui_widths
}

tui_reindex () {
    for (( tui_i = 0; tui_i < ${#TUI_ORDER[@]}; tui_i++ )); do
        TUI_POS[${TUI_ORDER[tui_i]}]=$tui_i
    done
}

# Everything under a closed directory drops out of view; TUI_N counts what is
# left, so movement and drawing work on rows without knowing about the tree.
tui_rebuild_vis () {
    TUI_VIS=()
    tui_skipd=-1
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( tui_skipd >= 0 )) && (( TUI_DEPTH[tui_id] > tui_skipd )); then
            continue
        fi
        tui_skipd=-1
        # "t" hides what is already downloaded. It is a view filter and
        # nothing more: the tree, the marks and the order are untouched, so
        # showing them again puts everything back exactly where it was. A
        # hidden directory takes its subtree with it -- everything under a
        # complete directory is complete by definition.
        if (( tui_show_done == 0 )) && [[ ${TUI_STATUS[tui_id]} == c ]]; then
            if (( TUI_ISDIR[tui_id] == 1 )); then
                tui_skipd=${TUI_DEPTH[tui_id]}
            fi
            continue
        fi
        TUI_VIS+=("$tui_id")
        if (( TUI_ISDIR[tui_id] == 1 )) && (( TUI_OPEN[tui_id] == 0 )); then
            tui_skipd=${TUI_DEPTH[tui_id]}
        fi
    done
    TUI_N=${#TUI_VIS[@]}
    if (( tui_cur >= TUI_N )); then
        tui_cur=$(( TUI_N - 1 ))
    fi
    if (( tui_cur < 0 )); then
        tui_cur=0
    fi
    tui_scroll
}

# Children are inserted straight after their parent, so a subtree is always a
# run of consecutive entries -- which is what makes these two cheap.
tui_subtree () {
    tui_r0=$(( $1 + 1 ))
    tui_r1=$tui_r0
    tui_d=${TUI_DEPTH[${TUI_ORDER[$1]}]}
    while (( tui_r1 < ${#TUI_ORDER[@]} )) && (( TUI_DEPTH[${TUI_ORDER[tui_r1]}] > tui_d )); do
        tui_r1=$(( tui_r1 + 1 ))
    done
}

tui_children () {
    tui_kids=()
    tui_subtree "${TUI_POS[$1]}"
    tui_d=$(( TUI_DEPTH[$1] + 1 ))
    for (( tui_i = tui_r0; tui_i < tui_r1; tui_i++ )); do
        if (( TUI_DEPTH[${TUI_ORDER[tui_i]}] == tui_d )); then
            tui_kids+=("${TUI_ORDER[tui_i]}")
        fi
    done
}

# Where a node sits in the visible rows, in $tui_vidx, or -1 when a closed
# directory above it means it is not on screen at all.
tui_vis_pos () {
    tui_vidx=-1
    for (( tui_i = 0; tui_i < TUI_N; tui_i++ )); do
        if (( TUI_VIS[tui_i] == $1 )); then
            tui_vidx=$tui_i
            return 0
        fi
    done
}

# Alt-j / Alt-k: move the entry under the cursor within its sibling group, the
# cursor going with it. A directory takes its whole subtree along, which costs
# nothing -- children sit directly behind their parent, so an entry and all of
# its descendants are one contiguous run of TUI_ORDER and the move is a swap of
# two adjacent runs. Nothing ever changes parent: the ends of the sibling group
# stop it, and TUI_SELCNT stays right because no parent/child pair changed.
# The order that comes out is the download priority, top first (see LINESO).
tui_move_node () {
    tui_node=${TUI_VIS[tui_cur]}
    tui_blk0=${TUI_POS[tui_node]}
    tui_subtree "$tui_blk0"
    tui_blk1=$tui_r1
    if [[ $1 == down ]]; then
        # Whatever follows the subtree is the next sibling exactly when it is
        # at the same depth; anything shallower is the end of the group.
        tui_sib=$tui_blk1
        if (( tui_sib >= ${#TUI_ORDER[@]} )) \
           || (( TUI_DEPTH[${TUI_ORDER[tui_sib]}] != TUI_DEPTH[tui_node] )); then
            tui_msg="${TUI_NAME[tui_node]} is already last here"
            return 0
        fi
        tui_subtree "$tui_sib"
        tui_sib1=$tui_r1
        TUI_ORDER=("${TUI_ORDER[@]:0:tui_blk0}" \
                   "${TUI_ORDER[@]:tui_blk1:tui_sib1 - tui_blk1}" \
                   "${TUI_ORDER[@]:tui_blk0:tui_blk1 - tui_blk0}" \
                   "${TUI_ORDER[@]:tui_sib1}")
    else
        # Backwards to the first entry at this depth; a shallower one first
        # means the parent, and there is no sibling above.
        tui_sib=-1
        for (( tui_i = tui_blk0 - 1; tui_i >= 0; tui_i-- )); do
            if (( TUI_DEPTH[${TUI_ORDER[tui_i]}] < TUI_DEPTH[tui_node] )); then
                break
            fi
            if (( TUI_DEPTH[${TUI_ORDER[tui_i]}] == TUI_DEPTH[tui_node] )); then
                tui_sib=$tui_i
                break
            fi
        done
        if (( tui_sib < 0 )); then
            tui_msg="${TUI_NAME[tui_node]} is already first here"
            return 0
        fi
        TUI_ORDER=("${TUI_ORDER[@]:0:tui_sib}" \
                   "${TUI_ORDER[@]:tui_blk0:tui_blk1 - tui_blk0}" \
                   "${TUI_ORDER[@]:tui_sib:tui_blk0 - tui_sib}" \
                   "${TUI_ORDER[@]:tui_blk1}")
    fi
    tui_reindex
    tui_rebuild_vis
    tui_vis_pos "$tui_node"
    if (( tui_vidx >= 0 )); then
        tui_cur=$tui_vidx
    fi
    tui_scroll
}

# The nearest ancestor already marked for download, if any: everything under it
# comes along, so its descendants show "+" without holding a state of their own.
tui_sel_ancestor () {
    tui_anc=-1
    tui_p=${TUI_PARENT[$1]}
    while (( tui_p >= 0 )); do
        if (( TUI_STATE[tui_p] == 1 )); then
            tui_anc=$tui_p
            return 0
        fi
        tui_p=${TUI_PARENT[tui_p]}
    done
    return 0
}

# The one place a state changes, so the "some of this directory is selected"
# counters can be kept up to date on the way past.
tui_set_state () {
    tui_old=${TUI_STATE[$1]}
    if (( tui_old == $2 )); then
        return 0
    fi
    TUI_STATE[$1]=$2
    tui_delta=0
    if (( tui_old == 1 )); then
        tui_delta=$(( tui_delta - 1 ))
    fi
    if (( $2 == 1 )); then
        tui_delta=$(( tui_delta + 1 ))
    fi
    if (( tui_old == 2 )); then
        tui_nrm=$(( tui_nrm - 1 ))
    fi
    if (( $2 == 2 )); then
        tui_nrm=$(( tui_nrm + 1 ))
    fi
    if (( tui_old == 3 )); then
        tui_ndel=$(( tui_ndel - 1 ))
    fi
    if (( $2 == 3 )); then
        tui_ndel=$(( tui_ndel + 1 ))
    fi
    if (( tui_delta != 0 )); then
        tui_nsel=$(( tui_nsel + tui_delta ))
        tui_p=${TUI_PARENT[$1]}
        while (( tui_p >= 0 )); do
            TUI_SELCNT[tui_p]=$(( TUI_SELCNT[tui_p] + tui_delta ))
            tui_p=${TUI_PARENT[tui_p]}
        done
    fi
}

tui_clear_subtree () {
    tui_subtree "${TUI_POS[$1]}"
    for (( tui_i = tui_r0; tui_i < tui_r1; tui_i++ )); do
        tui_set_state "${TUI_ORDER[tui_i]}" 0
    done
}

# Taking one entry out of a directory that was selected whole: the directory
# stops being a single mirror and becomes the list of everything it holds
# except this one.
tui_split_ancestor () {
    tui_chain=("$1")
    tui_p=${TUI_PARENT[$1]}
    while (( tui_p >= 0 )) && (( tui_p != $2 )); do
        tui_chain=("$tui_p" ${tui_chain[@]+"${tui_chain[@]}"})
        tui_p=${TUI_PARENT[tui_p]}
    done
    tui_set_state "$2" 0
    tui_walk=$2
    for tui_step in ${tui_chain[@]+"${tui_chain[@]}"}; do
        tui_children "$tui_walk"
        for tui_kid in ${tui_kids[@]+"${tui_kids[@]}"}; do
            if (( tui_kid != tui_step )); then
                tui_set_state "$tui_kid" 1
            fi
        done
        tui_walk=$tui_step
    done
    tui_set_state "$1" 0
}

tui_toggle () {
    tui_node=${TUI_VIS[tui_cur]}
    # "-" and "x" are decisions about the remote side; space overrides either
    # with the ordinary one, which is the only harmless direction to move in.
    if (( TUI_STATE[tui_node] == 2 )) || (( TUI_STATE[tui_node] == 3 )); then
        tui_set_state "$tui_node" 1
        return 0
    fi
    tui_sel_ancestor "$tui_node"
    if (( tui_anc >= 0 )); then
        tui_split_ancestor "$tui_node" "$tui_anc"
        return 0
    fi
    if (( TUI_STATE[tui_node] == 1 )); then
        tui_set_state "$tui_node" 0
        return 0
    fi
    # A directory showing "*" holds a selection made further down; space takes
    # all of it back rather than swallowing the directory whole.
    if (( TUI_SELCNT[tui_node] > 0 )); then
        tui_clear_subtree "$tui_node"
        return 0
    fi
    tui_clear_subtree "$tui_node"
    tui_set_state "$tui_node" 1
}

# "d" marks the source symlink for removal, which only the top level has one
# of: everything below is a real file or directory inside the target.
tui_mark_remove () {
    tui_node=${TUI_VIS[tui_cur]}
    # In srcs mode the top level is the source directories themselves, which
    # are not symlinks and are not this run's to remove.
    if (( TUI_DEPTH[tui_node] == 0 )) && [[ $srcs_mode == True ]]; then
        tui_msg="${TUI_NAME[tui_node]} is a source directory, not an entry"
        return 0
    fi
    if (( TUI_DEPTH[tui_node] > 0 )); then
        tui_msg="only a top-level entry has a symlink to remove"
        return 0
    fi
    if (( TUI_STATE[tui_node] == 2 )); then
        tui_set_state "$tui_node" 0
    else
        tui_clear_subtree "$tui_node"
        tui_set_state "$tui_node" 2
    fi
}

# "x": drop the symlink from the completed directory *and* the data behind it.
# Nothing here or anywhere else undoes that, so it asks first -- drawn as the
# footer, with the list still visible behind it, the way the quit dialog is.
# Only "Y" confirms; every other key, and a terminal that went away, cancels.
tui_delete_prompt () {
    tui_prompt="delete ${TUI_NAME[$1]} and the data behind it? (Y confirms, any other key cancels)"
    tui_answer=no
    while true; do
        tui_draw
        TUI_KEYRC=1
        if tui_read_key; then
            if [[ $TUI_KEY == Y ]]; then
                tui_answer=yes
            fi
            break
        fi
        # A timeout is not an answer: tick, redraw and go on waiting for one.
        if (( TUI_KEYRC != 2 )); then
            break
        fi
        tui_tick
    done
    tui_prompt=""
}

tui_mark_delete () {
    tui_node=${TUI_VIS[tui_cur]}
    if (( TUI_DEPTH[tui_node] == 0 )) && [[ $srcs_mode == True ]]; then
        tui_msg="${TUI_NAME[tui_node]} is a source directory, not an entry"
        return 0
    fi
    # Taking the mark off again destroys nothing, so it does not ask.
    if (( TUI_STATE[tui_node] == 3 )); then
        tui_set_state "$tui_node" 0
        return 0
    fi
    tui_delete_prompt "$tui_node"
    if [[ $tui_answer != yes ]]; then
        tui_msg="${TUI_NAME[tui_node]} left alone"
        return 0
    fi
    # An entry inside a directory that was selected whole would still be
    # mirrored by it, so take it out of that mirror before marking it.
    tui_sel_ancestor "$tui_node"
    if (( tui_anc >= 0 )); then
        tui_split_ancestor "$tui_node" "$tui_anc"
    fi
    tui_clear_subtree "$tui_node"
    tui_set_state "$tui_node" 3
}

# a/A work on the download selection and leave the "-" and "x" marks alone:
# those are a separate decision about the remote side. "R" is the one that
# clears everything.
tui_set_all () {
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( TUI_STATE[tui_id] == 2 )) || (( TUI_STATE[tui_id] == 3 )); then
            continue
        fi
        if (( TUI_DEPTH[tui_id] > 0 )); then
            tui_set_state "$tui_id" 0
        else
            tui_set_state "$tui_id" "$1"
        fi
    done
}

# "r" takes the mark off the entry under the cursor. A selected directory is
# cleared along with everything under it, so one keystroke undoes one decision
# however much of the tree that decision covered.
tui_clear_mark () {
    tui_node=${TUI_VIS[tui_cur]}
    tui_sel_ancestor "$tui_node"
    if (( tui_anc >= 0 )); then
        # The mark being shown is the ancestor's, not this entry's: splitting
        # it is what "clear this one" has to mean, or nothing would change.
        tui_split_ancestor "$tui_node" "$tui_anc"
        return 0
    fi
    # tui_clear_subtree is descendants only, so the entry itself follows.
    tui_clear_subtree "$tui_node"
    tui_set_state "$tui_node" 0
}

# "R" clears every mark in the tree -- "+", "-" and "x" alike, which is what
# makes it more than a synonym for "A".
tui_clear_all () {
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        tui_set_state "$tui_id" 0
    done
}

# ------------------------------------------------------------------ STATUS --
# What is already on disk. This is the second of the picker's two state axes:
# TUI_STATE says what the run will *do* to an entry, TUI_STATUS what is true
# about it whatever the marks say, and the STATUS column draws the latter.
#
# Getting the expected size right is most of the work, because the completed
# directory does not have it: its size column is the length of the *symlink*
# ("../../data/TV/notes.nfo" lists as 23 for an 11 byte file), and a server
# that stats through the link instead reports something else again. So the
# figures come from $listfile5, a size listing of the data directory, and even
# there they are rounded -- lftp prints nothing useful for --size unless -h is
# given too, which buys a figure at the price of it being "4.1G". Every
# comparison therefore carries the tolerance that rounding forces on it, and
# anything that cannot be established comes out empty rather than guessed.

# name -> size, from the data directory's own listing ("size name", one entry
# per line). This is the real size of what is behind each top-level symlink.
# TUI_DUSIZE is the other half of the same question, for the entries that are
# directories: --dir-sizes asks the server for a recursive total, and where it
# came back that total is the only figure that says anything about how much of
# the directory there is. It is kept per name rather than as a "-ds was given"
# flag because it frequently comes back for nothing at all: lftp's du does not
# follow symlinks, so in a completed directory of them it reports only ".".
tui_load_sizes () {
    unset TUI_RSIZE
    declare -gA TUI_RSIZE=()
    unset TUI_DUSIZE
    declare -gA TUI_DUSIZE=()
    if [[ -n $listfile3 ]] && [[ -s $listfile3 ]]; then
        while IFS=$'\t' read -r tui_sz tui_nm; do
            tui_nm=${tui_nm#./}
            tui_nm=${tui_nm%/}
            if [[ -n $tui_nm ]] && [[ $tui_nm != "." ]] && [[ -n $tui_sz ]]; then
                TUI_DUSIZE[$tui_nm]=$tui_sz
            fi
        done < "$listfile3"
    fi
    if [[ -z $listfile5 ]] || [[ ! -s $listfile5 ]]; then
        return 0
    fi
    while IFS= read -r tui_scratch || [[ -n $tui_scratch ]]; do
        tui_scratch=${tui_scratch#"${tui_scratch%%[![:space:]]*}"}
        tui_sz=${tui_scratch%%[[:space:]]*}
        tui_nm=${tui_scratch#*[[:space:]]}
        tui_nm=${tui_nm#"${tui_nm%%[![:space:]]*}"}
        tui_strip_class "$tui_nm"
        if [[ -n $tui_stripped ]] && [[ -n $tui_sz ]] && [[ $tui_sz != "$tui_nm" ]]; then
            TUI_RSIZE[$tui_stripped]=$tui_sz
        fi
    done < "$listfile5"
}

# A size as an lftp listing spells it, in bytes, plus the tolerance its own
# rounding forces on any comparison: "4.1G" stands for everything from 4.05G to
# 4.15G, so $tui_tol is a last digit's worth and a match means "within that",
# never equality. A plain byte count is exact and gets no tolerance at all.
# $tui_bytes comes back -1 for anything unrecognised, which is the answer that
# leaves the status empty instead of inventing one.
tui_size_bytes () {
    tui_bytes=-1
    tui_tol=0
    if [[ ! $1 =~ ^([0-9]+)(\.([0-9]))?([KkMmGgTt]?)$ ]]; then
        return 0
    fi
    tui_num=${BASH_REMATCH[1]}
    tui_frac=${BASH_REMATCH[3]}
    case ${BASH_REMATCH[4]} in
        K|k) tui_unit=1024 ;;
        M|m) tui_unit=1048576 ;;
        G|g) tui_unit=1073741824 ;;
        T|t) tui_unit=1099511627776 ;;
        *)   tui_unit=1 ;;
    esac
    if [[ -z $tui_frac ]]; then
        tui_bytes=$(( tui_num * tui_unit ))
        # No decimal at all is a coarser rounding, not a finer one.
        if (( tui_unit > 1 )); then
            tui_tol=$(( tui_unit / 2 ))
        fi
    else
        tui_bytes=$(( (tui_num * 10 + tui_frac) * tui_unit / 10 ))
        tui_tol=$(( tui_unit / 10 ))
    fi
}

# The local sizes of everything the check needs one for, in a single du: a fork
# per entry would be felt on a listing of any size. du gives bytes for a file
# and a recursive total for a directory, and says nothing at all about a path
# that is not there.
tui_local_sizes () {
    unset TUI_LSIZE
    declare -gA TUI_LSIZE=()
    if [[ ${#tui_dulist[@]} -eq 0 ]]; then
        return 0
    fi
    while IFS=$'\t' read -r tui_lbytes tui_lpath; do
        if [[ -n $tui_lpath ]] && [[ -n $tui_lbytes ]]; then
            TUI_LSIZE[$tui_lpath]=$tui_lbytes
        fi
    done < <(printf '%s\0' "${tui_dulist[@]}" | du -sb --files0-from=- 2> /dev/null)
}

# Whether a directory has a recursive total to be judged against. Only the top
# level can: --dir-sizes walks one level down from $remote_dl_dir, and a
# listing fetched by tab carries directory-entry sizes, which mean nothing.
# The comparison it enables is deliberately biased: the server totals up sizes
# rounded to a block per file, and du -sb here does not, so the remote figure
# is the larger of the two by up to a block per file and a directory whose
# content is small enough for that to show reads as incomplete when it is not.
# That is the harmless direction -- the entry stays visible and gets fetched
# again, which mirror -c settles in seconds -- and opening the directory
# replaces the guess with an exact answer from its children.
tui_has_du () {
    if (( TUI_DEPTH[$1] != 0 )); then
        return 1
    fi
    tui_strip_class "${TUI_NAME[$1]}"
    if [[ -z ${TUI_DUSIZE[$tui_stripped]:-} ]]; then
        return 1
    fi
    return 0
}

# Complete, incomplete or unknowable, from the remote size and what is on disk.
tui_compare_size () {
    tui_stat=u
    tui_size_bytes "${TUI_SIZE[$1]}"
    if (( tui_bytes < 0 )); then
        return 0
    fi
    tui_lbytes=${TUI_LSIZE[${TUI_LPATH[$1]}]:-}
    if [[ -z $tui_lbytes ]]; then
        return 0
    fi
    if (( tui_lbytes + tui_tol >= tui_bytes )); then
        tui_stat=c
    else
        tui_stat=i
    fi
}

# One entry's verdict, in $tui_stat: "c" complete, "i" there but short, "m" not
# downloaded at all, "u" no way to tell. Only the first two are ever drawn --
# "m" is an ordinary entry waiting to be fetched and "u" is a question this
# cannot answer, and both of those are worth nothing in the column.
#
# A directory is judged by its children wherever they are loaded, which is the
# only honest way: the size a listing gives a directory is the size of the
# directory entry, not of what is in it. Where they are not loaded, --dir-sizes
# is the one thing that supplies a real total, and without it the answer stays
# empty. One missing or short child is proof that the directory is incomplete;
# a child that could not be judged only blocks the verdict "complete".
tui_status_node () {
    tui_stat=u
    if (( TUI_LHAVE[$1] == 0 )); then
        tui_stat=m
    elif (( TUI_ISDIR[$1] == 1 )); then
        if (( TUI_HASKID[$1] == 1 )); then
            case ${TUI_ACC[$1]} in
                p) tui_stat=i ;;
                c) tui_stat=c ;;
                *) tui_stat=u ;;
            esac
        elif (( TUI_LOADED[$1] == 1 )); then
            # Listed and empty: there is nothing left to fetch.
            tui_stat=c
        elif tui_has_du "$1"; then
            tui_compare_size "$1"
        fi
    else
        tui_compare_size "$1"
    fi
    TUI_LSTAT[$1]=$tui_stat
    case $tui_stat in
        c|i) TUI_STATUS[$1]=$tui_stat ;;
        *)   TUI_STATUS[$1]="" ;;
    esac
    tui_p=${TUI_PARENT[$1]}
    if (( tui_p >= 0 )); then
        TUI_HASKID[tui_p]=1
        case $tui_stat in
            m|i) TUI_ACC[tui_p]=p ;;
            u)   if [[ ${TUI_ACC[tui_p]} != p ]]; then TUI_ACC[tui_p]=u; fi ;;
            *)   if [[ -z ${TUI_ACC[tui_p]} ]]; then TUI_ACC[tui_p]=c; fi ;;
        esac
    fi
}

# Fill TUI_STATUS for the whole tree. Two passes: the first works out where
# each entry would land locally and whether it is there at all, and collects
# the paths worth a size; the second runs backwards through TUI_ORDER, which
# puts every child before its parent (children sit directly behind the parent
# they belong to), so a directory's verdict is folded up out of children that
# have already been decided.
tui_status_scan () {
    tui_dulist=()
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        TUI_ACC[tui_id]=""
        TUI_HASKID[tui_id]=0
        tui_strip_class "${TUI_PATH[tui_id]}"
        local_target_for "$tui_stripped"
        TUI_LPATH[tui_id]=$target
        if [[ -e $target ]]; then
            TUI_LHAVE[tui_id]=1
        else
            TUI_LHAVE[tui_id]=0
            continue
        fi
        # A directory judged by its children needs no size of its own, and a
        # du of it would be a walk of the whole subtree for nothing.
        if (( TUI_ISDIR[tui_id] == 1 )) \
           && { (( TUI_LOADED[tui_id] == 1 )) || ! tui_has_du "$tui_id"; }; then
            continue
        fi
        tui_dulist+=("$target")
    done
    tui_local_sizes
    for (( tui_i = ${#TUI_ORDER[@]} - 1; tui_i >= 0; tui_i-- )); do
        tui_status_node "${TUI_ORDER[tui_i]}"
    done
    tui_status_width
}

# The width of the STATUS column, over every node rather than the visible ones
# so it does not jump about as directories open. Zero means no status is known
# at all, and the column is left out entirely -- a listing with nothing to say
# looks exactly as it did before there was a column. Later work writes transfer
# progress into TUI_STATUS as well, so this is called wherever it changes.
tui_status_width () {
    tui_statusw=0
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( ${#TUI_STATUS[tui_id]} > tui_statusw )); then
            tui_statusw=${#TUI_STATUS[tui_id]}
        fi
    done
}

# "t": show or hide what is already downloaded.
tui_toggle_done () {
    if (( tui_statusw == 0 )); then
        tui_msg="nothing here is known to be downloaded already"
        return 0
    fi
    if (( tui_show_done == 1 )); then
        tui_show_done=0
    else
        tui_show_done=1
    fi
    tui_rebuild_vis
    # Hiding the lot would leave a screen with no cursor on it, which is worse
    # than the answer the user was after.
    if (( TUI_N == 0 )); then
        tui_show_done=1
        tui_rebuild_vis
        tui_msg="everything here is already downloaded"
    fi
}

# Column widths over every node loaded, indentation included, so the columns
# stay put when a directory is opened or closed.
tui_widths () {
    tui_namew=0
    tui_sizew=0
    tui_datew=0
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        tui_i=$(( TUI_DEPTH[tui_id] * 2 + ${#TUI_NAME[tui_id]} ))
        if (( tui_i > tui_namew )); then
            tui_namew=$tui_i
        fi
        if (( ${#TUI_SIZE[tui_id]} > tui_sizew )); then
            tui_sizew=${#TUI_SIZE[tui_id]}
        fi
        # DATE was the last column and needed no width of its own; with STATUS
        # behind it, it does.
        if (( ${#TUI_DATE[tui_id]} > tui_datew )); then
            tui_datew=${#TUI_DATE[tui_id]}
        fi
    done
    tui_status_width
}

tui_marker () {
    if (( TUI_STATE[$1] == 3 )); then
        tui_mark="x"
    elif (( TUI_STATE[$1] == 2 )); then
        tui_mark="-"
    elif (( TUI_STATE[$1] == 1 )); then
        tui_mark="+"
    else
        tui_sel_ancestor "$1"
        if (( tui_anc >= 0 )); then
            tui_mark="+"
        elif (( TUI_SELCNT[$1] > 0 )); then
            tui_mark="*"
        else
            tui_mark=" "
        fi
    fi
}

# Cut a line to the width of the terminal so nothing wraps and shifts the rest
# of the screen down.
tui_fit () {
    if (( $2 <= 0 )); then
        tui_fitted=""
    elif (( ${#1} > $2 )); then
        tui_fitted=${1:0:$2}
    else
        tui_fitted=$1
    fi
}

# One screen, built as a single string and written in one go: no cursor
# addressing (that would be a tput fork per row) and no flicker. Every line is
# padded and cleared to the right edge, so what was there before is covered.
tui_draw () {
    tui_left="alftp  ${remote_dl_dir}"
    # A check is a background login the user cannot otherwise see; the glyph
    # turning is all there is to say that the listing is being asked about.
    if [[ -n $tui_upd_pid ]]; then
        tui_left="$tui_left  [${tui_spin_frames:tui_spin:1}]"
    fi
    tui_right="${tui_nsel} selected"
    if (( tui_nrm > 0 )); then
        tui_right="$tui_right, $tui_nrm to unlink"
    fi
    if (( tui_ndel > 0 )); then
        tui_right="$tui_right, $tui_ndel to delete"
    fi
    # Only worth saying where there is something to hide; a listing with no
    # STATUS column has no "t" to press either.
    if (( tui_statusw > 0 )); then
        if (( tui_show_done == 1 )); then
            tui_right="$tui_right  completed=T"
        else
            tui_right="$tui_right  completed=F"
        fi
    fi
    tui_pad=$(( TUI_COLS - ${#tui_left} - ${#tui_right} - 2 ))
    if (( tui_pad < 1 )); then
        tui_fit "$tui_left" $(( TUI_COLS - ${#tui_right} - 3 ))
        tui_left=$tui_fitted
        tui_pad=1
    fi
    printf -v tui_line ' %s%*s%s ' "$tui_left" "$tui_pad" "" "$tui_right"
    tui_fit "$tui_line" "$TUI_COLS"
    tui_out="${t_home}${t_rev}${tui_fitted}${t_sgr0}${t_el}"$'\n'

    # Column header, lined up with the two-column selection gutter.
    if (( tui_statusw > 0 )); then
        printf -v tui_line '  %-*s  %*s  %-*s  %*s' "$tui_namew" "NAME" \
            "$tui_sizew" "SIZE" "$tui_datew" "DATE" "$tui_statusw" "STATUS"
    else
        printf -v tui_line '  %-*s  %*s  %s' "$tui_namew" "NAME" "$tui_sizew" "SIZE" "DATE"
    fi
    tui_fit "$tui_line" "$TUI_COLS"
    tui_out+="${t_bold}${tui_fitted}${t_sgr0}${t_el}"$'\n'

    for (( tui_i = tui_top; tui_i < tui_top + TUI_ROWS; tui_i++ )); do
        if (( tui_i < TUI_N )); then
            tui_id=${TUI_VIS[tui_i]}
            tui_marker "$tui_id"
            if (( tui_statusw > 0 )); then
                printf -v tui_line '%s %*s%-*s  %*s  %-*s  %*s' "$tui_mark" \
                    "$(( TUI_DEPTH[tui_id] * 2 ))" "" \
                    "$(( tui_namew - TUI_DEPTH[tui_id] * 2 ))" "${TUI_NAME[tui_id]}" \
                    "$tui_sizew" "${TUI_SIZE[tui_id]}" \
                    "$tui_datew" "${TUI_DATE[tui_id]}" \
                    "$tui_statusw" "${TUI_STATUS[tui_id]}"
            else
                printf -v tui_line '%s %*s%-*s  %*s  %s' "$tui_mark" \
                    "$(( TUI_DEPTH[tui_id] * 2 ))" "" \
                    "$(( tui_namew - TUI_DEPTH[tui_id] * 2 ))" "${TUI_NAME[tui_id]}" \
                    "$tui_sizew" "${TUI_SIZE[tui_id]}" "${TUI_DATE[tui_id]}"
            fi
            tui_fit "$tui_line" "$TUI_COLS"
            if (( tui_i == tui_cur )); then
                printf -v tui_line '%-*s' "$TUI_COLS" "$tui_fitted"
                tui_out+="${t_rev}${tui_line}${t_sgr0}${t_el}"$'\n'
            else
                tui_out+="${tui_fitted}${t_el}"$'\n'
            fi
        else
            tui_out+="${t_el}"$'\n'
        fi
    done

    if [[ -n $tui_prompt ]]; then
        tui_fit "$tui_prompt" "$TUI_COLS"
        printf -v tui_line '%-*s' "$TUI_COLS" "$tui_fitted"
        tui_out+="${t_rev}${tui_line}${t_sgr0}${t_el}"
    else
        if [[ -n $tui_msg ]]; then
            tui_line=$tui_msg
        elif (( TUI_COLS >= 100 )); then
            tui_line="j/k move  M-j/k reorder  space pick  tab open  d unlink  x delete  r/R clear  t done  u check  a/A  q quit"
        elif (( TUI_COLS >= 74 )); then
            tui_line="j/k move  M-j/k order  space pick  tab open  d/x mark  r/R clear  t  u  q quit"
        else
            tui_line="j/k  M-j/k  space  tab  d  x  r/R  t  u  q"
        fi
        if (( TUI_N > TUI_ROWS )); then
            printf -v tui_line '%s   %s-%s/%s' "$tui_line" \
                "$(( tui_top + 1 ))" "$(( tui_top + TUI_ROWS < TUI_N ? tui_top + TUI_ROWS : TUI_N ))" "$TUI_N"
        fi
        tui_fit " $tui_line" "$TUI_COLS"
        tui_out+="${t_dim}${tui_fitted}${t_sgr0}${t_el}"
    fi
    printf '%s' "$tui_out" >&"$TUI_OUT"
}

# One keystroke, or one escape sequence: after ESC the rest of the sequence is
# already in the buffer, so a short timeout tells a real arrow key from a bare
# ESC without making the UI feel sluggish.
#
# The wait for the first character is not open-ended any more: with
# $tui_read_timeout set (which tui_open does, and only there -- a caller
# driving this without a terminal still blocks) it gives up after that long so
# that the caller can tick. Which of the two things happened is in $TUI_KEYRC,
# because the return code cannot say: read answers 1 at end of input and
# something over 128 on a timeout, and telling those apart is the difference
# between "the terminal went away, stop" and "nothing was typed, carry on".
# Callers set TUI_KEYRC=1 before calling, so that a stub which only returns a
# code still reads as end of input.
tui_read_key () {
    TUI_KEY=""
    TUI_KEYRC=0
    if [[ -n $tui_read_timeout ]]; then
        tui_keyrc=0
        IFS= read -rN1 -t "$tui_read_timeout" -u "$TUI_IN" TUI_KEY || tui_keyrc=$?
        if (( tui_keyrc > 128 )); then
            TUI_KEYRC=2
            return 1
        fi
        if (( tui_keyrc != 0 )); then
            TUI_KEYRC=1
            return 1
        fi
    else
        IFS= read -rN1 -u "$TUI_IN" TUI_KEY || { TUI_KEYRC=1; return 1; }
    fi
    if [[ $TUI_KEY == $'\e' ]]; then
        while IFS= read -rN1 -t 0.05 -u "$TUI_IN" tui_scratch; do
            TUI_KEY+=$tui_scratch
            if [[ $tui_scratch == [A-Za-z~] ]]; then
                break
            fi
        done
    fi
    return 0
}

# Keys to actions. Both the letter and the escape-sequence spelling of every
# movement key land here, which is also what makes the mapping testable
# without a terminal.
tui_key_action () {
    case $1 in
        j|$'\e[B'|$'\eOB')                     tui_action=down ;;
        k|$'\e[A'|$'\eOA')                     tui_action=up ;;
        0|$'\e[H'|$'\eOH'|$'\e[1~'|$'\e[7~')   tui_action=top ;;
        G|$'\e[F'|$'\eOF'|$'\e[4~'|$'\e[8~')   tui_action=bottom ;;
        $'\e[5~')                              tui_action=pgup ;;
        $'\e[6~')                              tui_action=pgdn ;;
        $'\ej'|$'\e[1;3B')                      tui_action=movedn ;;
        $'\ek'|$'\e[1;3A')                      tui_action=moveup ;;
        ' '|$'\n'|$'\r')                       tui_action=toggle ;;
        $'\t')                                 tui_action=open ;;
        d)                                     tui_action="unlink" ;;
        x|$'\e[3~')                             tui_action=delete ;;
        r)                                     tui_action=clear ;;
        t)                                     tui_action=showdone ;;
        u)                                     tui_action=update ;;
        R)                                     tui_action=clearall ;;
        a)                                     tui_action=all ;;
        A)                                     tui_action=none ;;
        q|$'\e')                               tui_action=quit ;;
        $'\f')                                 tui_action=redraw ;;
        *)                                     tui_action=ignore ;;
    esac
}

tui_move () {
    case $tui_action in
        up)     if (( tui_cur > 0 )); then tui_cur=$(( tui_cur - 1 )); fi ;;
        down)   if (( tui_cur < TUI_N - 1 )); then tui_cur=$(( tui_cur + 1 )); fi ;;
        top)    tui_cur=0 ;;
        bottom) tui_cur=$(( TUI_N - 1 )) ;;
        pgup)   tui_cur=$(( tui_cur - TUI_ROWS )) ;;
        pgdn)   tui_cur=$(( tui_cur + TUI_ROWS )) ;;
    esac
    if (( tui_cur < 0 )); then
        tui_cur=0
    fi
    if (( tui_cur > TUI_N - 1 )); then
        tui_cur=$(( TUI_N - 1 ))
    fi
    tui_scroll
}

# Keep the cursor on screen, and the screen full: after a resize or a jump to
# the end there is no reason to leave blank rows below the last entry.
tui_scroll () {
    if (( tui_cur < tui_top )); then
        tui_top=$tui_cur
    fi
    if (( tui_cur >= tui_top + TUI_ROWS )); then
        tui_top=$(( tui_cur - TUI_ROWS + 1 ))
    fi
    if (( tui_top > TUI_N - TUI_ROWS )); then
        tui_top=$(( TUI_N - TUI_ROWS ))
    fi
    if (( tui_top < 0 )); then
        tui_top=0
    fi
}

# List one remote directory. The session that spawned this one is blocked in
# its "!" waiting for the picker to finish, so this is a login of its own --
# once per directory, since what it finds stays in the tree.
tui_fetch () {
    tui_strip_class "${TUI_PATH[$1]}"
    tui_msg="listing ${TUI_NAME[$1]} ..."
    tui_draw
    new_tmp "${TMPDIR:-/tmp}/alftp.sub.XXXXXX"; tui_raw="$tmpfile_new"
    new_tmp "${TMPDIR:-/tmp}/alftp.subdata.XXXXXX"; tui_rawdata="$tmpfile_new"
    new_tmp "${TMPDIR:-/tmp}/alftp.sublog.XXXXXX"; tui_log="$tmpfile_new"
    new_tmp "${TMPDIR:-/tmp}/alftp.subcmd.XXXXXX"; tui_script="$tmpfile_new"
    # A directory of symlinks tells the same lie one level down as the top
    # level does: cls -F marks a symlink "@" whether it points at a file or at
    # a directory, so the data behind it is listed too and answers the
    # question the way $listfile2 answers it for the top level. It is listed by
    # path rather than by cd'ing to it, so a path that is not there costs an
    # error line in the log and nothing else.
    link_entry_path "$tui_stripped"
    #DO NOT INDENT CONTENTS
    cat > "$tui_script" << EOF
$(open_cmd)
$(set_opts)
cd "$remote_dl_dir"
cd $(lftp_quote "$tui_stripped")
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > $(lftp_quote "$tui_raw")
cls -1 $(lftp_quote "$link_path/") > $(lftp_quote "$tui_rawdata")
quit
EOF
    tui_msg=""
    # Only the listing that was asked for decides whether this worked: the
    # data listing beside it is an extra, and a server that will not give it
    # leaves the types exactly as they were before.
    if ! lftp -f "$tui_script" < /dev/null > "$tui_log" 2>&1 && [[ ! -s $tui_raw ]]; then
        tui_msg="could not list ${TUI_NAME[$1]}: $(head -n 1 "$tui_log")"
        if [[ -n ${ALFTP_DEBUG:-} ]]; then
            tui_msg="$tui_msg (script $tui_script)"
        else
            rm -f "$tui_script" "$tui_raw" "$tui_rawdata" "$tui_log"
        fi
        return 1
    fi
    unset TUI_SUBDIR
    declare -gA TUI_SUBDIR=()
    if [[ -s $tui_rawdata ]]; then
        while IFS= read -r tui_scratch || [[ -n $tui_scratch ]]; do
            # Listed by path rather than after a cd, cls answers in full paths,
            # so only the last component is the name to key on.
            if [[ $tui_scratch == */ ]]; then
                tui_scratch=${tui_scratch%/}
                TUI_SUBDIR[${tui_scratch##*/}]=1
            fi
        done < "$tui_rawdata"
    fi
    tui_kidsnew=()
    while IFS=$'\t' read -r tui_nm tui_sz tui_dt; do
        tui_isdir=0
        tui_strip_class "$tui_nm"
        if [[ $tui_nm == */ ]] || [[ -n ${TUI_SUBDIR[$tui_stripped]:-} ]]; then
            tui_isdir=1
        fi
        tui_add_node "$tui_nm" "$tui_sz" "$tui_dt" "$1" "$tui_isdir"
        tui_kidsnew+=("$tui_new_id")
    done < <(format_columns "$tui_raw" "" | tui_parse_listing /dev/stdin)
    tui_i=${TUI_POS[$1]}
    TUI_ORDER=("${TUI_ORDER[@]:0:tui_i + 1}" ${tui_kidsnew[@]+"${tui_kidsnew[@]}"} \
               "${TUI_ORDER[@]:tui_i + 1}")
    TUI_LOADED[$1]=1
    tui_reindex
    # What was just listed decides this directory's own status as well as its
    # children's, so the whole tree is re-folded rather than patched.
    tui_status_scan
    tui_widths
    if (( ${#tui_kidsnew[@]} == 0 )); then
        tui_msg="${TUI_NAME[$1]} is empty"
    fi
    rm -f "$tui_script" "$tui_raw" "$tui_rawdata" "$tui_log"
    return 0
}

# ------------------------------------------------------------------ UPDATE --
# A listing goes stale while it is being picked over: a release finishes
# uploading, another one is removed. "u" asks the server again now, and
# update_interval asks it every so many seconds without being told to.
#
# The check cannot be done where tui_fetch does its work, because tui_fetch
# blocks: a login against a slow server would freeze the picker for as long as
# it took. So the check is one background lftp, and the loop stops waiting for
# a keystroke for ever -- tui_read_key gained a timeout, and every time it
# expires tui_tick runs. That is the general shape, not an update-specific one:
# anything that has to happen while the user is doing nothing hangs off
# tui_tick.
#
# What comes back is merged into the tree rather than replacing it. Everything
# the user has done -- the marks, which directories are open, and above all the
# order, which is the download priority -- has to survive a check, so a
# surviving entry keeps its node and its place in TUI_ORDER, an entry that
# appeared is added at the end of its sibling group (which keeps a subtree one
# contiguous run), and an entry that vanished is dropped only when nothing
# would be lost with it.

# The tick. It runs on every expiry of tui_read_key's timeout -- about five
# times a second, from tui_loop and from the prompts that read a key of their
# own -- and never while a keystroke is waiting, so it is the picker's idle
# time and nothing else.
#
# What it may assume: the tree is whole and consistent (no key is half-handled
# around it), the screen has been drawn, and it is the only thing running.
# What it must not do: block, read a key, or draw. Redrawing is the loop's job
# and it does it when $tui_dirty says something changed, which is what keeps an
# idle picker from repainting five times a second for nothing. Work that takes
# any time at all belongs in a background job that a later tick reaps, which is
# what the update does.
tui_tick () {
    if [[ -n $tui_upd_pid ]]; then
        tui_spin=$(( (tui_spin + 1) % ${#tui_spin_frames} ))
        tui_dirty=1
        if ! kill -0 "$tui_upd_pid" 2> /dev/null; then
            tui_upd_reap
        fi
        return 0
    fi
    if (( update_interval > 0 )) && (( SECONDS - tui_upd_last >= update_interval )); then
        tui_upd_start
    fi
}

# One of the check's listing files, made once and then reused. The check runs
# again every update_interval seconds, and a fresh mktemp per listing per check
# would leave a pile of them for the run to clean up at the end.
tui_upd_tmp () {
    if [[ -n $1 ]]; then
        tui_upd_name=$1
        : > "$tui_upd_name"
        return 0
    fi
    new_tmp "${TMPDIR:-/tmp}/alftp.upd.XXXXXX" || return 1
    tui_upd_name=$tmpfile_new
}

# Ask the server again, in the background. The listings are exactly the ones
# the run's own session fetched -- the completed directory, its long form, the
# data directory and its sizes -- plus the listing tui_fetch would fetch for
# every directory the user has already opened, so that the whole of the tree
# that is on screen is checked and not only its top level. du is deliberately
# left out: it walks the entire tree below the directory, and no size in the
# column is worth that every update_interval seconds.
tui_upd_start () {
    if [[ -n $tui_upd_pid ]]; then
        return 1
    fi
    tui_upd_last=$SECONDS
    tui_upd_ids=()
    tui_upd_tmp "$tui_upd_top";     tui_upd_top=$tui_upd_name
    tui_upd_tmp "$tui_upd_topdata"; tui_upd_topdata=$tui_upd_name
    tui_upd_tmp "$tui_upd_topsize"; tui_upd_topsize=$tui_upd_name
    tui_upd_tmp "$tui_upd_toplong"; tui_upd_toplong=$tui_upd_name
    tui_upd_tmp "$tui_upd_log";     tui_upd_log=$tui_upd_name
    tui_upd_tmp "$tui_upd_script";  tui_upd_script=$tui_upd_name
    #DO NOT INDENT CONTENTS
    cat > "$tui_upd_script" << EOF
$(open_cmd)
$(set_opts)
cd "$remote_dl_dir"
cls -1 -F -h --size --date --time-style="%Y-%m-%d %H:%M" > $(lftp_quote "$tui_upd_top")
ls -l > $(lftp_quote "$tui_upd_toplong")
cd "$data_dir""$dirname"
cls -1 > $(lftp_quote "$tui_upd_topdata")
cls -1 -F -h --size > $(lftp_quote "$tui_upd_topsize")
EOF
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( TUI_LOADED[tui_id] == 0 )); then
            continue
        fi
        tui_strip_class "${TUI_PATH[tui_id]}"
        tui_upd_path=$tui_stripped
        link_entry_path "$tui_upd_path"
        tui_upd_tmp "${TUI_UPD_RAW[tui_id]:-}";  TUI_UPD_RAW[tui_id]=$tui_upd_name
        tui_upd_tmp "${TUI_UPD_DATA[tui_id]:-}"; TUI_UPD_DATA[tui_id]=$tui_upd_name
        tui_upd_ids+=("$tui_id")
        {
            printf 'cd "%s"\n' "$remote_dl_dir"
            printf 'cd %s\n' "$(lftp_quote "$tui_upd_path")"
            printf 'cls -1 -F -h --size --date --time-style="%%Y-%%m-%%d %%H:%%M" > %s\n' \
                "$(lftp_quote "${TUI_UPD_RAW[tui_id]}")"
            printf 'cls -1 %s > %s\n' "$(lftp_quote "$link_path/")" \
                "$(lftp_quote "${TUI_UPD_DATA[tui_id]}")"
        } >> "$tui_upd_script"
    done
    printf 'quit\n' >> "$tui_upd_script"
    # Nothing of this may reach the screen: the picker owns it, and lftp's
    # chatter would be painted over the list. stdin is closed off for the same
    # reason -- a prompt it decided to ask would eat the user's keystrokes.
    lftp -f "$tui_upd_script" < /dev/null > "$tui_upd_log" 2>&1 &
    tui_upd_pid=$!
    tui_spin=0
    tui_dirty=1
    return 0
}

# Stop a check that is still running: quitting, or being interrupted, should
# not leave a login behind.
tui_upd_stop () {
    if [[ -z $tui_upd_pid ]]; then
        return 0
    fi
    kill -TERM "$tui_upd_pid" 2> /dev/null
    wait "$tui_upd_pid" 2> /dev/null
    tui_upd_pid=""
}

# The check finished. Its own listing is the only thing that says whether it
# worked -- the same rule tui_fetch goes by -- and a failure changes nothing at
# all, because a tree merged against half a listing would lose entries that are
# still on the server.
tui_upd_reap () {
    tui_upd_rc=0
    wait "$tui_upd_pid" 2> /dev/null || tui_upd_rc=$?
    tui_upd_pid=""
    tui_dirty=1
    if (( tui_upd_rc != 0 )) && [[ ! -s $tui_upd_top ]]; then
        tui_upd_name=$(head -n 1 "$tui_upd_log" 2> /dev/null) || tui_upd_name=""
        tui_msg="could not check the remote${tui_upd_name:+: $tui_upd_name}"
        return 0
    fi
    tui_upd_merge
}

# In srcs mode the top level is the source directories the profile named, not
# everything $complete_dir happens to hold, so a fresh listing is cut down the
# way SRCS_FILTER cuts down the run's own.
tui_upd_srcs_ok () {
    if [[ $srcs_mode != True ]]; then
        return 0
    fi
    for tui_upd_s in ${SRCS[@]+"${SRCS[@]}"}; do
        if [[ $tui_upd_s == "$1" ]]; then
            return 0
        fi
    done
    return 1
}

# Drop a node and everything under it. Both halves matter: the states go
# through tui_set_state so that the selection counters of every ancestor stay
# right, and the splice takes the whole subtree, which is one contiguous run of
# TUI_ORDER and leaves the runs around it contiguous too.
tui_upd_drop () {
    tui_subtree "${TUI_POS[$1]}"
    tui_upd_i0=$(( tui_r0 - 1 ))
    tui_upd_i1=$tui_r1
    # tui_upd_m rather than tui_i: tui_reindex below runs on tui_i, and this is
    # called from the middle of a loop of tui_upd_group's own.
    for (( tui_upd_m = tui_upd_i0; tui_upd_m < tui_upd_i1; tui_upd_m++ )); do
        tui_set_state "${TUI_ORDER[tui_upd_m]}" 0
        TUI_DEAD[${TUI_ORDER[tui_upd_m]}]=1
    done
    TUI_ORDER=("${TUI_ORDER[@]:0:tui_upd_i0}" "${TUI_ORDER[@]:tui_upd_i1}")
    tui_reindex
}

# Merge one fresh listing into one sibling group: $1 is the parent (-1 for the
# top level), $2 the listing and $3 the data listing beside it, which is what
# says which entries are directories (cls -F marks every symlink "@" whatever
# it points at).
#
# An entry that is still there keeps its node -- and with it its mark, its
# status, whether it is open, and where in the order the user put it -- and
# takes only the fresh size and date. It keeps the kind it was listed with as
# well: a name that changed from a file to a directory is a different entry,
# and its path, its children and its local status were all built on the old
# answer. An entry that is gone is dropped, unless it carries a mark or has one
# below it, in which case removing it would throw away a decision the user
# made; those stay, and the footer says how many. Anything new goes at the end
# of the group, which is where an entry nobody has looked at yet belongs and,
# in a subtree, the only place that keeps the run contiguous.
tui_upd_group () {
    if [[ ! -s $2 ]]; then
        return 0
    fi
    unset TUI_UPD_SUB
    declare -gA TUI_UPD_SUB=()
    unset TUI_UPD_IDX
    declare -gA TUI_UPD_IDX=()
    unset TUI_UPD_HAVE
    declare -gA TUI_UPD_HAVE=()
    if [[ -s $3 ]]; then
        while IFS= read -r tui_scratch || [[ -n $tui_scratch ]]; do
            if [[ $tui_scratch == */ ]]; then
                tui_scratch=${tui_scratch%/}
                TUI_UPD_SUB[${tui_scratch##*/}]=1
            fi
        done < "$3"
    fi
    tui_upd_nm=(); tui_upd_sz=(); tui_upd_dt=(); tui_upd_kind=()
    while IFS=$'\t' read -r tui_nm tui_sz tui_dt; do
        tui_strip_class "$tui_nm"
        if (( $1 < 0 )) && ! tui_upd_srcs_ok "$tui_stripped"; then
            continue
        fi
        tui_isdir=0
        if [[ $tui_nm == */ ]] || [[ -n ${TUI_UPD_SUB[$tui_stripped]:-} ]]; then
            tui_isdir=1
        fi
        if (( $1 < 0 )); then
            tui_real_size "$tui_stripped" "$tui_isdir"
        fi
        TUI_UPD_IDX[$tui_stripped]=${#tui_upd_nm[@]}
        tui_upd_nm+=("$tui_nm"); tui_upd_sz+=("$tui_sz")
        tui_upd_dt+=("$tui_dt"); tui_upd_kind+=("$tui_isdir")
    done < <(format_columns "$2" "" | tui_parse_listing /dev/stdin)

    # The group as it stands. Collected first and worked through backwards, so
    # that dropping one entry cannot move an index that is still to be looked
    # at -- and held by id rather than by position, which tui_upd_drop rewrites.
    tui_upd_old=()
    if (( $1 < 0 )); then
        for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
            if (( TUI_DEPTH[tui_id] == 0 )); then
                tui_upd_old+=("$tui_id")
            fi
        done
    else
        tui_children "$1"
        tui_upd_old=(${tui_kids[@]+"${tui_kids[@]}"})
    fi
    for (( tui_upd_k = ${#tui_upd_old[@]} - 1; tui_upd_k >= 0; tui_upd_k-- )); do
        tui_id=${tui_upd_old[tui_upd_k]}
        tui_strip_class "${TUI_NAME[tui_id]}"
        if [[ -n ${TUI_UPD_IDX[$tui_stripped]:-} ]]; then
            TUI_UPD_HAVE[$tui_stripped]=1
            tui_upd_j=${TUI_UPD_IDX[$tui_stripped]}
            TUI_SIZE[tui_id]=${tui_upd_sz[tui_upd_j]}
            TUI_DATE[tui_id]=${tui_upd_dt[tui_upd_j]}
            continue
        fi
        if (( TUI_STATE[tui_id] != 0 )) || (( TUI_SELCNT[tui_id] > 0 )); then
            tui_upd_kept=$(( tui_upd_kept + 1 ))
            continue
        fi
        tui_upd_drop "$tui_id"
        tui_upd_gone=$(( tui_upd_gone + 1 ))
    done

    tui_upd_add=()
    for (( tui_upd_k = 0; tui_upd_k < ${#tui_upd_nm[@]}; tui_upd_k++ )); do
        tui_strip_class "${tui_upd_nm[tui_upd_k]}"
        if [[ -n ${TUI_UPD_HAVE[$tui_stripped]:-} ]]; then
            continue
        fi
        tui_add_node "${tui_upd_nm[tui_upd_k]}" "${tui_upd_sz[tui_upd_k]}" \
            "${tui_upd_dt[tui_upd_k]}" "$1" "${tui_upd_kind[tui_upd_k]}"
        tui_upd_add+=("$tui_new_id")
    done
    if (( ${#tui_upd_add[@]} == 0 )); then
        return 0
    fi
    if (( $1 < 0 )); then
        tui_upd_i1=${#TUI_ORDER[@]}
    else
        tui_subtree "${TUI_POS[$1]}"
        tui_upd_i1=$tui_r1
    fi
    TUI_ORDER=("${TUI_ORDER[@]:0:tui_upd_i1}" "${tui_upd_add[@]}" \
               "${TUI_ORDER[@]:tui_upd_i1}")
    tui_upd_new=$(( tui_upd_new + ${#tui_upd_add[@]} ))
    tui_reindex
}

# Fold the whole check into the tree. The run's own listing files are replaced
# first, because everything that reads them later -- LOAD_LINKS, the size
# lookup, and TYPE once the picker is done -- should be answering from what is
# on the server now rather than from what was there when the session opened.
# $listfile itself is not touched: tui_save writes it from the tree.
tui_upd_merge () {
    tui_upd_new=0; tui_upd_gone=0; tui_upd_kept=0
    unset TUI_DEAD
    declare -gA TUI_DEAD=()
    if [[ -n $listfile2 ]] && [[ -s $tui_upd_topdata ]]; then
        cp -f "$tui_upd_topdata" "$listfile2"
    fi
    if [[ -n $listfile5 ]] && [[ -s $tui_upd_topsize ]]; then
        cp -f "$tui_upd_topsize" "$listfile5"
    fi
    if [[ -n $listfile4 ]] && [[ -s $tui_upd_toplong ]]; then
        cp -f "$tui_upd_toplong" "$listfile4"
        LOAD_LINKS
    fi
    tui_load_sizes
    # The node under the cursor is the one piece of state the tree does not
    # hold, so it is remembered across a merge that may move rows about under
    # it. A cursor on an entry that has just been dropped has nothing to go
    # back to, and tui_rebuild_vis puts it somewhere sane.
    tui_upd_cur=-1
    if (( TUI_N > 0 )) && (( tui_cur < TUI_N )); then
        tui_upd_cur=${TUI_VIS[tui_cur]}
    fi
    tui_upd_group -1 "$tui_upd_top" "$tui_upd_topdata"
    for tui_upd_id in ${tui_upd_ids[@]+"${tui_upd_ids[@]}"}; do
        if [[ -n ${TUI_DEAD[$tui_upd_id]:-} ]]; then
            continue
        fi
        tui_upd_group "$tui_upd_id" "${TUI_UPD_RAW[$tui_upd_id]}" \
            "${TUI_UPD_DATA[$tui_upd_id]}"
    done
    tui_status_scan
    tui_widths
    tui_rebuild_vis
    if (( tui_upd_cur >= 0 )) && [[ -z ${TUI_DEAD[$tui_upd_cur]:-} ]]; then
        tui_vis_pos "$tui_upd_cur"
        if (( tui_vidx >= 0 )); then
            tui_cur=$tui_vidx
            tui_scroll
        fi
    fi
    if (( tui_upd_new == 0 )) && (( tui_upd_gone == 0 )) && (( tui_upd_kept == 0 )); then
        tui_msg="checked: nothing has changed"
        return 0
    fi
    tui_msg="checked: $tui_upd_new new, $tui_upd_gone gone"
    if (( tui_upd_kept > 0 )); then
        tui_msg="$tui_msg, $tui_upd_kept marked but no longer on the server"
    fi
}

# "u": check now, whatever the timer is doing.
tui_update_now () {
    if [[ -n $tui_upd_pid ]]; then
        tui_msg="a check is already running"
        return 0
    fi
    tui_upd_start
    tui_msg="checking the remote ..."
}

tui_toggle_open () {
    tui_node=${TUI_VIS[tui_cur]}
    if (( TUI_ISDIR[tui_node] == 0 )); then
        tui_msg="${TUI_NAME[tui_node]} is not a directory"
        return 0
    fi
    if (( TUI_OPEN[tui_node] == 1 )); then
        TUI_OPEN[tui_node]=0
        tui_rebuild_vis
        return 0
    fi
    if (( TUI_LOADED[tui_node] == 0 )); then
        if ! tui_fetch "$tui_node"; then
            return 0
        fi
    fi
    TUI_OPEN[tui_node]=1
    tui_rebuild_vis
}

# q asks before it does anything irreversible. Drawn as the footer of the
# normal screen, so the list stays visible behind the question.
tui_quit_prompt () {
    tui_prompt="quit: (c)ancel   (s)ave and download   (e)xit without downloading"
    tui_answer=""
    while [[ -z $tui_answer ]]; do
        tui_draw
        TUI_KEYRC=1
        if ! tui_read_key; then
            if (( TUI_KEYRC == 2 )); then
                tui_tick
                continue
            fi
            tui_answer="exit"
            break
        fi
        case $TUI_KEY in
            c|C|$'\e')     tui_answer=cancel ;;
            s|S)           tui_answer=save ;;
            e|E|q|Q)       tui_answer="exit" ;;
        esac
    done
    tui_prompt=""
}

# The event loop. Kept free of terminal setup so a test can drive it with a
# stubbed tui_read_key and TUI_OUT pointed somewhere harmless.
tui_loop () {
    tui_result=""
    while true; do
        if [[ $tui_resized == 1 ]]; then
            tui_resized=0
            tui_size
            tui_scroll
            printf '%s' "$t_clear" >&"$TUI_OUT"
        fi
        tui_draw
        # Wait for a key, but not for ever: every expiry of the read's timeout
        # is one tick, which is where the background check is started, animated
        # and reaped. Only a redraw the tick asked for is done here -- an idle
        # picker with nothing running repaints nothing at all.
        TUI_KEYRC=1
        while ! tui_read_key; do
            if (( TUI_KEYRC != 2 )); then
                tui_result="exit"
                return 0
            fi
            tui_tick
            if (( tui_dirty == 1 )); then
                tui_dirty=0
                tui_draw
            fi
            TUI_KEYRC=1
        done
        tui_msg=""
        tui_key_action "$TUI_KEY"
        case $tui_action in
            up|down|top|bottom|pgup|pgdn)
                tui_move
                ;;
            toggle)
                tui_toggle
                ;;
            open)
                tui_toggle_open
                ;;
            movedn)
                tui_move_node down
                ;;
            moveup)
                tui_move_node up
                ;;
            unlink)
                tui_mark_remove
                ;;
            delete)
                tui_mark_delete
                ;;
            clear)
                tui_clear_mark
                ;;
            showdone)
                tui_toggle_done
                ;;
            update)
                tui_update_now
                ;;
            clearall)
                tui_clear_all
                ;;
            all)
                tui_set_all 1
                ;;
            none)
                tui_set_all 0
                ;;
            redraw)
                printf '%s' "$t_clear" >&"$TUI_OUT"
                ;;
            quit)
                tui_quit_prompt
                case $tui_answer in
                    save)
                        tui_result=save
                        return 0
                        ;;
                    exit)
                        tui_result="exit"
                        return 0
                        ;;
                esac
                ;;
        esac
    done
}

tui_open () {
    tui_owns_fd=0
    if [[ $tui_dev_tty == 1 ]]; then
        exec {TUI_IN}<> /dev/tty || return 1
        TUI_OUT=$TUI_IN
        tui_owns_fd=1
    elif [[ -t 0 ]] && [[ -t 1 ]]; then
        TUI_IN=0
        TUI_OUT=1
    else
        return 1
    fi
    tui_open_flag=1
    tui_saved_stty=$(stty -g <&"$TUI_IN" 2> /dev/null) || tui_saved_stty=""
    # Raw enough to get a keystroke at a time with nothing echoed; bash's
    # read -N would do most of this per call, but not between calls.
    stty -echo -icanon min 1 time 0 <&"$TUI_IN" 2> /dev/null
    tui_saved_int=$(trap -p INT)
    tui_saved_term=$(trap -p TERM)
    tui_saved_winch=$(trap -p WINCH)
    trap 'tui_abort' INT TERM
    trap 'tui_resized=1' WINCH
    # Only a real terminal ticks: everything else that drives tui_loop (a test,
    # for one) has no background work and wants the read to block.
    tui_read_timeout=$tui_tick_interval
    printf '%s%s%s' "$t_smcup" "$t_civis" "$t_clear" >&"$TUI_OUT"
    return 0
}

tui_close () {
    if [[ $tui_open_flag != 1 ]]; then
        return 0
    fi
    tui_open_flag=0
    tui_read_timeout=""
    # A check still in flight has nothing left to report to, and its login is
    # this run's to close.
    tui_upd_stop
    printf '%s%s%s' "$t_sgr0" "$t_cnorm" "$t_rmcup" >&"$TUI_OUT"
    if [[ -n $tui_saved_stty ]]; then
        stty "$tui_saved_stty" <&"$TUI_IN" 2> /dev/null
    fi
    # Only a fd this opened is ours to close; stdin and stdout are not.
    if [[ $tui_owns_fd == 1 ]]; then
        exec {TUI_IN}>&-
        tui_owns_fd=0
    fi
    TUI_IN=0
    TUI_OUT=1
    trap - INT TERM WINCH
    if [[ -n $tui_saved_int ]]; then eval "$tui_saved_int"; fi
    if [[ -n $tui_saved_term ]]; then eval "$tui_saved_term"; fi
    if [[ -n $tui_saved_winch ]]; then eval "$tui_saved_winch"; fi
}

# Ctrl-C means "I did not choose anything": leave the list empty rather than
# leaving whatever was on screen to be downloaded.
tui_abort () {
    tui_close
    : > "$listfile"
    echo "alftp: interrupted, nothing selected." >&2
    exit 130
}

# Write the selection back for TYPE to read: one line per node that says
# something, marked "+" download, "-" unlink, "*" a directory whose selection
# is on the lines below it, "#" not wanted. A path below the top level carries
# its own trailing "/" when it is a directory.
tui_save () {
    tui_pathw=0
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( ${#TUI_PATH[tui_id]} > tui_pathw )); then
            tui_pathw=${#TUI_PATH[tui_id]}
        fi
    done
    new_tmp "${TMPDIR:-/tmp}/alftp.sel.XXXXXX"; tui_scratch="$tmpfile_new"
    for tui_id in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
        if (( TUI_DEPTH[tui_id] > 0 )) && (( TUI_STATE[tui_id] == 0 )) \
           && (( TUI_SELCNT[tui_id] == 0 )); then
            continue
        fi
        case ${TUI_STATE[tui_id]} in
            3) tui_mark="x" ;;
            2) tui_mark="-" ;;
            1) tui_mark="+" ;;
            *)
                if (( TUI_SELCNT[tui_id] > 0 )); then
                    tui_mark="*"
                else
                    tui_mark="#"
                fi
                ;;
        esac
        if [[ -z ${TUI_DATE[tui_id]} ]]; then
            printf '%s%s\n' "$tui_mark" "${TUI_PATH[tui_id]}"
        else
            printf '%s%-*s  %*s  %s\n' "$tui_mark" "$tui_pathw" "${TUI_PATH[tui_id]}" \
                "$tui_sizew" "${TUI_SIZE[tui_id]}" "${TUI_DATE[tui_id]}"
        fi
    done > "$tui_scratch" && mv "$tui_scratch" "$listfile"
    rm -f "$tui_scratch"
}

# -c: CONTINUE_LIST has already marked the listing with last session's picks,
# but tui_load drops every marker on purpose (a reloaded list starts
# deselected), so put them back through the one function allowed to set state.
# Only top-level entries can be matched: nothing below them exists in the tree
# until a directory is opened.
tui_apply_marks () {
    while IFS=$'\t' read -r tui_mark tui_nm; do
        for tui_i in ${TUI_ORDER[@]+"${TUI_ORDER[@]}"}; do
            if [[ ${TUI_PATH[tui_i]} == "$tui_nm" ]]; then
                if [[ $tui_mark == "-" ]]; then
                    tui_set_state "$tui_i" 2
                else
                    tui_set_state "$tui_i" 1
                fi
                break
            fi
        done
    done < <(marked_entries "$listfile")
}

tui_select () {
    tui_cur=0
    tui_top=0
    # A timer that is not a whole number of seconds is not a timer; anything
    # else in the config leaves the check to "u" rather than failing the run.
    if [[ ! $update_interval =~ ^[0-9]+$ ]]; then
        update_interval=0
    fi
    tui_upd_last=$SECONDS
    tui_prompt=""
    tui_msg=""
    tui_resized=0
    tui_load
    if [[ $continue_prev == True ]]; then
        tui_apply_marks
    fi
    if (( TUI_N == 0 )); then
        echo "alftp: the listing is empty, nothing to pick."
        return 0
    fi
    if ! tui_open; then
        tui_why="cannot open the terminal"
        return 1
    fi
    tui_size
    tui_loop
    tui_close
    if [[ $tui_result == save ]]; then
        tui_save
        tui_scratch="alftp: saved $tui_nsel selection(s)"
        if (( tui_nrm > 0 )); then
            tui_scratch="$tui_scratch, $tui_nrm unlink(s)"
        fi
        if (( tui_ndel > 0 )); then
            tui_scratch="$tui_scratch, $tui_ndel deletion(s)"
        fi
        echo "$tui_scratch to $listfile."
    else
        : > "$listfile"
        echo "alftp: nothing selected."
    fi
    return 0
}

# Hand the listing to whichever picker is in play. Both leave $listfile in the
# same state -- wanted lines uncommented, the rest commented out -- which is
# all TYPE reads back.
pick_list () {
    if tui_usable && tui_select; then
        return 0
    fi
    if [[ $picker == tui ]]; then
        echo "alftp: using \$editor instead of the terminal UI ($tui_why)." >&2
    fi
    # The editor convention is the inverse of the UI's: with -i every entry is
    # commented out for the user to uncomment what they want. With -c the marks
    # CONTINUE_LIST just wrote are the selection to start from, so those lines
    # are left as they are.
    if [[ $ind_files == True ]]; then
        if [[ $continue_prev == True ]]; then
            sed -i 's/^\([^#+-]\)/#\1/g' "$listfile"
        else
            sed -i 's/^\([^#]\)/#\1/g' "$listfile"
        fi
    fi
    $editor "$listfile"
}

# Let the user pick entries out of the listing. Shared by both paths: in the
# single-session path this runs inside the lftp session, via EMIT_DL.
# The symlinks are checked here rather than in the picker, so that both pickers
# -- and a run with -a -q, which uses the list without showing it to anyone --
# see the same list, with the broken entries already gone.
EDIT_LIST () {
    FORMAT_LIST
    SRCS_FILTER
    LOAD_LINKS
    VALIDATE_LINKS
    # After the pruning, so what -c carries over is what is still really there.
    if [[ $continue_prev == True ]]; then
        CONTINUE_LIST
    fi
    if [[ $all_files == True ]]; then
        if [[ $quiet != True ]]; then
            pick_list
        fi
    elif [[ $ind_files == True ]]; then
        pick_list
    fi
}

# One line per entry, tab separated so it greps and cuts: when, which profile,
# which entry, what happened to it. A log that cannot be written is not worth
# failing a finished download over, so this never reports an error of its own.
log_event () {
    if [[ -z $1 ]]; then
        return 0
    fi
    printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        "${profile:-${dirname:-.}}" "$2" "$3" >> "$1" 2> /dev/null || return 0
}

# checksum=True: a line per downloaded entry saying exactly what landed -- its
# size in bytes and, for a single file, its sha256 -- so that what is on disk
# can be checked later against what was fetched, and two copies of the same
# release can be compared without re-downloading either.
#
# It deliberately does not compare against the size in the listing: the
# completed directory is full of symlinks, and a server that reports the size
# of the link rather than of the file behind it (which is what a plain
# filesystem does) would make every entry look wrong. lftp's own xfer:verify is
# not used either -- its verify-file helper needs perl modules that are often
# missing, and when it fails it takes the transfer down with it, along with the
# symlink removal that follows a successful one.
verify_entry () {
    verify_size=$(du -sb -- "$1" 2> /dev/null | cut -f1) || verify_size=""
    if [[ -d $1 ]] || ! command -v sha256sum > /dev/null 2>&1; then
        verify_sum="-"
    else
        verify_sum=$(sha256sum -- "$1" 2> /dev/null) || verify_sum=""
        verify_sum=${verify_sum%% *}
    fi
    log_event "$verify" "$2" "bytes=${verify_size:-?} sha256=${verify_sum:--}"
}

# There is no success line to read back out of lftp: the session's output goes
# to the terminal (and in the single-session path shares it with the picker),
# so the honest test of whether an entry arrived is the local side -- it is
# here, or it is not.
record_result () {
    if [[ -e $1 ]]; then
        if [[ $no_append != True ]]; then
            log_event "$record" "$2" "downloaded"
        fi
        if [[ ${checksum,,} == true ]]; then
            verify_entry "$1" "$2"
        fi
    else
        log_event "$errors" "$2" "did not arrive"
    fi
}

# Downloaded content keeps the permissions and the owner it arrived with unless
# the config asks for something else: chmod=True applies perms_dirs to
# directories and perms_files to files, chown=True hands the lot to $owner.
apply_perms () {
    if [[ ${chmod,,} == true ]]; then
        if [[ -d $1 ]]; then
            find "$1" -type d -exec chmod "$perms_dirs" {} +
            find "$1" -type f -exec chmod "$perms_files" {} +
        else
            chmod "$perms_files" "$1"
        fi
    fi
    if [[ ${chown,,} == true ]] && [[ -n $owner ]]; then
        chown -R "$owner" "$1"
    fi
}

POST_PROCESS () {
    # Neither of these downloaded anything: -cl removed the entries instead,
    # and --dry-run only said what it would have done.
    if [[ $dry_run == True ]] || [[ $clean == True ]]; then
        return 0
    fi
    # Where content landed is local_dir_for's question, not $local_dl_dir's:
    # in srcs mode each source directory answers it differently. The SsS
    # sentinel stands in for a trailing space in the name.
    while read -r line; do
        if [[ -z $line ]]; then
            continue
        fi
        line=$(echo "$line" | sed 's|SsS$| |')
        local_target_for "$line"
        record_result "$target" "$line"
        if [[ -e $target ]]; then
            apply_perms "$target"
        fi
    done <<< "$LINESF"
    while read -r line; do
        if [[ -z $line ]]; then
            continue
        fi
        line=$(echo "$line" | sed 's|SsS$| |')
        local_target_for "$line"
        record_result "$target" "$line"
        if [[ ! -e $target ]]; then
            continue
        fi
        # Unpacking is opt-in (autoUncompress), and -nu turns it off for a run
        # even where the config asked for it.
        if [[ ${autoUncompress,,} == true ]] && [[ -z $nounrar ]]; then
            UNRAR_FUN "$target"
        fi
        apply_perms "$target"
    done <<< "$LINESD"
}

# "mark<TAB>name" for every entry the list file says something about: "+" (or
# no marker at all, which is what hand-editing produces) is a download and "-"
# an unlink. The size and date columns come off, so what is left is the name
# lftp is given -- the same thing TYPE reads, without deciding file or
# directory. "#" and "*" say nothing and are skipped.
marked_entries () {
    awk '
        function stripname(s) {
            if (match(s, /[ \t][ \t]+([^ \t]+[ \t]+)?[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/)) {
                s = substr(s, 1, RSTART - 1)
            }
            sub(/[ \t]+$/, "", s)
            return s
        }
        {
            line = $0
            if (line ~ /^[ \t]*$/) { next }
            mark = substr(line, 1, 1)
            if (mark == "#" || mark == "*") { next }
            if (mark == "+" || mark == "-") { line = substr(line, 2) }
            else { mark = "+" }
            name = stripname(line)
            if (name == "") { next }
            print mark "\t" name
        }
    ' "$1"
}

# -ls: say what was marked -- name, size and date, as the list shows them --
# and download nothing. The columns are already aligned, so the marker is all
# that comes off.
LIST_MARKED () {
    awk '
        {
            line = $0
            if (line ~ /^[ \t]*$/) { next }
            if (line ~ /^[#*-]/) { next }
            if (substr(line, 1, 1) == "+") { line = substr(line, 2) }
            print line
        }
    ' "$listfile"
}

# -c: last session's selection, carried into this run's listing. $oldfile is
# the list the picker saved last time (both session functions copy it aside
# before the fresh listing overwrites it), so its marks are the ones the user
# made: an entry that is still on the server comes up marked, an entry that is
# gone goes with it, and anything new starts unmarked as usual.
CONTINUE_LIST () {
    if [[ ! -s $oldfile ]]; then
        echo "alftp: -c: no previous session list in $oldfile; starting from an empty selection."
        return 0
    fi
    new_tmp "${TMPDIR:-/tmp}/alftp.cont.XXXXXX"; contmarks="$tmpfile_new"
    marked_entries "$oldfile" > "$contmarks"
    new_tmp "${TMPDIR:-/tmp}/alftp.cont.XXXXXX"; contlist="$tmpfile_new"
    awk -F'\t' '
        function stripname(s) {
            sub(/^[-+*#]/, "", s)
            if (match(s, /[ \t][ \t]+([^ \t]+[ \t]+)?[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9][ \t]*$/)) {
                s = substr(s, 1, RSTART - 1)
            }
            sub(/[ \t]+$/, "", s)
            return s
        }
        NR == FNR { old[$2] = $1; next }
        {
            if ($0 ~ /^[ \t]*$/) { print; next }
            key = stripname($0)
            if (key in old) {
                line = $0
                sub(/^[-+*#]/, "", line)
                print old[key] line
            } else {
                print
            }
        }
    ' "$contmarks" "$listfile" > "$contlist" && mv "$contlist" "$listfile"
    rm -f "$contlist"
    echo "alftp: -c: carried over $(grep -c '^[+-]' "$listfile") mark(s) from the previous session."
}

# Inverse of FORMAT_LIST, on stdin: remove the trailing "  size  date time"
# columns (and the padding in front of them) so only the filename is left.
# The size column is empty for directories, hence the optional group.
strip_columns () {
    sed -E 's/[[:space:]]{2,}([^[:space:]]+[[:space:]]+)?[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}[[:space:]]*$//'
}

#DETERMINE IF COMMNET, FILE, DIRECTORY
# Reads the picked list into four: directories to mirror, files to pget,
# entries whose source symlink is to be removed, and entries to delete outright.
# The leading character says which -- "+" download, "-" unlink, "x" delete,
# "#"/"*" leave alone -- and a line with no marker at all is a download, which
# is what hand-editing the file produces. (Which also means a hand-edited list
# must not leave an entry whose name begins with "-" or "x" unmarked; the
# picker always writes a marker, so this only bites a file edited by hand.)
# LINESO gets the downloads a second time, in the order the list had them,
# because that order is the priority the user set (see DLXFER).
TYPE () {
        LINESO=""
        LIST=$(awk '
            {
                line = $0
                if (line ~ /^[#*]/) { next }
                if (line ~ /^[ \t]*$/) { next }
                act = "get"
                if (substr(line, 1, 1) == "-") { act = "rm"; line = substr(line, 2) }
                else if (substr(line, 1, 1) == "x") { act = "del"; line = substr(line, 2) }
                else if (substr(line, 1, 1) == "+") { line = substr(line, 2) }
                print act "\t" line
            }
        ' "$listfile" | strip_columns | sed 's|@$||')
        LIST2=$(cat "$listfile2" 2> /dev/null) || LIST2=""

        while IFS=$'\t' read -r act line; do
            if [[ -z $line ]]; then
                continue
            fi
            if [[ $act == rm ]]; then
                # The name of the symlink to drop, without the "/" the listing
                # puts on a directory.
                add_line LINESR "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                continue
            fi
            if [[ $act == del ]]; then
                add_line LINESX "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                continue
            fi
            # Anything below the top level was never in $listfile2 to be looked
            # up, so its path carries its own type: a trailing "/" is a
            # directory. The path is kept whole, which is what puts the
            # download under the same structure it has on the server.
            if [[ ${line%/} == */* ]]; then
                if [[ $line == */ ]]; then
                    add_line LINESD "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                    add_order dir "$(echo "${line%/}" | sed 's|\s$|&SsS|')"
                else
                    add_line LINESF "$(echo "$line" | sed 's|\s$|&SsS|')"
                    add_order file "$(echo "$line" | sed 's|\s$|&SsS|')"
                fi
                continue
            fi
	    # XXX
            lined=$(echo "$LIST2" | grep -F "$line" | grep -e "/$" | sed 's|/$||' | sed 's|\s$|&SsS|') # last portion, handle trailing whitespace
            linef=$(echo "$LIST2" | grep -F "$line" | grep -v -e "/$" | grep -v -e "^$" | sed 's|\s$|&SsS|')

            add_line LINESD "$lined"
            add_line LINESF "$linef"
            add_order dir "$lined"
            add_order file "$linef"
        done <<< "$LIST"
}

# One "kind<TAB>path" record per path in $2 (which may hold several lines, as
# the $listfile2 lookup above can match more than one). This is the only place
# the list order is preserved, so nothing else may append to LINESO.
add_order () {
    if [[ -z $2 ]]; then
        return 0
    fi
    while IFS= read -r xfer_path; do
        if [[ -n $xfer_path ]]; then
            add_line LINESO "$1"$'\t'"$xfer_path"
        fi
    done <<< "$2"
}

# Append to one of the newline-separated LINES* strings, skipping empties.
# (Plain concatenation, not echo -e, so a backslash in a name survives.)
add_line () {
    if [[ -z $2 ]]; then
        return 0
    fi
    if [[ -z ${!1} ]]; then
        printf -v "$1" '%s' "$2"
    else
        printf -v "$1" '%s\n%s' "${!1}" "$2"
    fi
}

#INITIATE SESSION AND DOWNLOAD
DOWNLD () {
new_tmp "${TMPDIR:-/tmp}/alftp.dl.XXXXXX"; scriptfile="$tmpfile_new"
#DO NOT INDENT CONTENTS
cat > "$scriptfile" << EOF
$(open_cmd)
cd "$remote_dl_dir"
$(set_opts)
$(DLPRUNE)
$(DLXFER)
$(DLRM)
$(DLDEL)
EOF
run_lftp_script "$scriptfile"
}

set_opts () {
	echo "set ftp:ssl-allow no"
	echo "set mirror:use-pget-n 5"
	echo "set mirror:dereference yes"
	echo "set xfer:clobber yes"
	echo "set ftp:charset utf-8"
	echo "set file:charset utf-8"
	echo "set ftp:use-utf8"
	echo "set net:max-retries 3"
	echo "set net:persist-retries 3"
    echo "set net:timeout 60"
    # SFTP key authentication. This has to be an lftp directive in the
    # generated script -- as a bash statement "set" only reassigns this
    # script's own positional parameters, which is what it used to do.
    if [[ -n $keyfile ]]; then
        echo "set sftp:connect-program $(lftp_quote "ssh -a -x -i $keyfile")"
    fi
}

#set ftp:charset UTF-8
#set ftp:lang en_US
#set sftp:charset UTF-8

# Where one entry lands locally. Every ordinary run has a single answer --
# $local_dl_dir, with the whole selection path under it -- but in srcs mode the
# first component of the path is a source directory with a dl_dir scheme of its
# own, and that component is consumed by resolving it: with dl_dir_TV=/mnt/tv,
# "TV/Rel.One-GRP" lands in /mnt/tv/Rel.One-GRP, and with a general
# dl_dir=/dl/@profile it lands in /dl/TV/Rel.One-GRP, because @profile is the
# src here the way it is the profile name elsewhere.
# Two answers come back: $local_dir, the directory the download is rooted at,
# and $local_rel, the entry's path below it -- empty when the entry *is* that
# root, which is what selecting a whole src means. The destination is
# "$local_dir/$local_rel", or "$local_dir" when $local_rel is empty. The
# classifier cls -F puts on a name is not part of either.
local_dir_for () {
    local_dir="$local_dl_dir"
    local_rel=${1%[/@*]}
    if [[ $srcs_mode != True ]]; then
        return 0
    fi
    local_src=${local_rel%%/*}
    if [[ $local_rel == */* ]]; then
        local_rel=${local_rel#*/}
    else
        local_rel=""
    fi
    if [[ -z $local_src ]]; then
        return 0
    fi
    # profile_var_name's mapping, inline: this runs once per entry per redraw
    # of the status column, and a fork each time would be felt.
    local_var="local_dl_dir_${local_src//[^A-Za-z0-9_]/_}"
    if [[ -n ${!local_var:-} ]]; then
        local_dir="${!local_var}"
    fi
    local_dir=${local_dir//@profile/$local_src}
}

# The destination of one entry and the directory it has to exist in, in
# $target and $local_parent, from the two halves local_dir_for hands back.
local_target_for () {
    local_dir_for "$1"
    if [[ -n $local_rel ]]; then
        target="$local_dir/$local_rel"
    else
        target="$local_dir"
    fi
    local_parent=${target%/*}
}

# The same destination as lftp has to be handed it, in $local_out: the
# directory unquoted and the entry quoted after it, which is how the name
# (spaces, brackets and all) survives lftp's own parser. A whole src has no
# name below the directory, and then the directory itself is what is quoted --
# writing it with an empty name after the slash makes mirror take the source's
# basename and nest it a second time.
local_lftp_target () {
    local_target_for "$1"
    if [[ -n $local_rel ]]; then
        line_rel=$(echo "$local_rel" | sed 's/\[/"\["/g')
        printf -v local_out '%s/"%s"' "$local_dir" "$line_rel"
    else
        printf -v local_out '"%s"' "$local_dir"
    fi
}

#DOWNLOAD DIRECTORIES
# mirror -c is what makes a run resumable: it picks a partial transfer up where
# it stopped, and skips what already matches the remote, so re-running after an
# interruption (or after picking more out of the same directory) costs only
# what is actually missing. Permissions and timestamps come across with it,
# which is the rest of what "rsync -a" means here.
DLDR () {
    while read -r rawline; do
        dldr_line "$rawline"
    done <<< "$LINESD"
}

# One directory. Factored out of the loop so DLXFER can emit the same command
# for one entry at a time, in the order the picker left the list in.
dldr_line () {
        rawline=$(echo "$1" | sed 's|SsS$| |') # handle trailing whitespace
        if [[ -z $rawline ]]; then
            return 0
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')  # and brackets, for lftp's glob
        # A path with a directory in it came from inside an opened directory:
        # it lands under the same structure locally, and its symlink is not
        # this run's to remove -- only whole top-level entries have one. In
        # srcs mode nothing at the top level is a symlink either: those are the
        # source directories themselves, and removing one would take the whole
        # src with it.
        if [[ $rawline == */* ]] || [[ $srcs_mode == True ]]; then
            unlink_ok=""
        else
            unlink_ok=1
        fi
        local_lftp_target "$rawline"
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "mirror -c -P5 --dry-run \"$line\" $local_out; !echo DRY-RUN: \"$line\""
        elif [[ $norm == True ]] || [[ -z $unlink_ok ]]; then
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" $local_out; !echo COMPLETE: \"$line\""
        else
            echo "mirror -c -P5 --log="\"$logfile\"" \"$line\" $local_out && rm -f \"$line\""
	    echo "echo "COMPLETE: \"$line\"""
        fi
}

#DOWNLOAD FILES
# pget -c continues a part-transferred file rather than starting it again.
DLFL () {
    while read -r rawline; do
        dlfl_line "$rawline"
    done <<< "$LINESF"
}

dlfl_line () {
        rawline=$(echo "$1" | sed 's|SsS$| |') # handle trailing whitespace
        if [[ -z $rawline ]]; then
            return 0
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')  # and brackets, for lftp's glob
        if [[ $rawline == */* ]] || [[ $srcs_mode == True ]]; then
            unlink_ok=""
        else
            unlink_ok=1
        fi
        local_lftp_target "$rawline"
        if [[ $clean == True ]]; then
            echo "rm -f \"$line\"; !echo REMOVED: \"$line\""
        elif [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: pget \"$line\" -o $local_out"
        else
            # pget will not make the directory the file has to go in, and that
            # is any directory but the one the run was pointed at: a nested
            # path brings its own structure, and in srcs mode the src decides
            # where the download is rooted in the first place.
            if [[ $local_parent != "$local_dl_dir" ]]; then
                echo "!mkdir -p $(sh_quote "$local_parent")"
            fi
            if [[ $norm == True ]] || [[ -z $unlink_ok ]]; then
                echo "pget -c -n 5 \"$line\" -o $local_out; !echo COMPLETE: \"$line\""
            else
                echo "pget -c -n 5 \"$line\" -o $local_out && rm -f \"$line\""
                echo "echo "COMPLETE: \"$line\"""
            fi
        fi
}

#DOWNLOAD IN THE ORDER THE LIST HAD THEM
# The picker's order is the download priority (Alt-j/Alt-k set it), so the
# transfers are emitted from LINESO -- one "dir<TAB>path" or "file<TAB>path"
# record per entry, in list order -- rather than all the directories and then
# all the files. A caller that filled LINESD/LINESF by hand and left LINESO
# empty gets the old grouped order, which is exactly what it asked for.
DLXFER () {
    if [[ -z $LINESO ]]; then
        DLDR
        DLFL
        return 0
    fi
    while IFS=$'\t' read -r xfer_kind xfer_path; do
        case $xfer_kind in
            dir)  dldr_line "$xfer_path" ;;
            file) dlfl_line "$xfer_path" ;;
        esac
    done <<< "$LINESO"
}

#REMOVE SOURCE SYMLINKS
# The "-" mark in the picker: drop the symlink from the completed directory
# without downloading anything.
DLRM () {
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |')
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')
        if [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: rm \"$line\""
        else
            echo "rm -f \"$line\"; !echo UNLINKED: \"$line\""
        fi
    done <<< "$LINESR"
}

#DELETE ENTRIES OUTRIGHT
# The "x" mark: the symlink *and* the data behind it, which is the only thing
# in this script that destroys something the user did not download first --
# hence the confirmation in the picker. The data path comes from what "ls -l"
# said the symlink points at (link_entry_path, and the layout as a fallback);
# it goes first, so a failure half way leaves a broken symlink for the pruner
# rather than data nobody can reach. "rm -r -f" covers a file and a directory
# alike, so nothing here has to know which it is. A nested entry has no symlink
# of its own -- only whole top-level entries do -- so it loses only its data.
DLDEL () {
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |')
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')
        link_entry_path "$rawline"
        del_path=$(echo "$link_path" | sed 's/\[/"\["/g')
        if [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: rm -r \"$del_path\""
            if [[ $rawline != */* ]]; then
                echo "!echo DRY-RUN: rm \"$line\""
            fi
        else
            echo "rm -r -f \"$del_path\"; !echo DELETED: \"$del_path\""
            if [[ $rawline != */* ]]; then
                echo "rm -f \"$line\"; !echo UNLINKED: \"$line\""
            fi
        fi
    done <<< "$LINESX"
}

#REMOVE BROKEN SYMLINKS
# The links VALIDATE_LINKS found pointing at data that is gone. Nobody selected
# them -- they are already out of the listing -- so this is housekeeping the
# session does on its way past. -do leaves the remote alone entirely, and
# --dry-run says what it would have removed.
DLPRUNE () {
    if [[ $norm == True ]]; then
        return 0
    fi
    while read -r rawline; do
        rawline=$(echo "$rawline" | sed 's|SsS$| |')
        if [[ -z $rawline ]]; then
            continue
        fi
        line=$(echo "$rawline" | sed 's/\[/"\["/g')
        if [[ $dry_run == True ]]; then
            echo "!echo DRY-RUN: rm broken \"$line\""
        else
            echo "rm -f \"$line\"; !echo PRUNED: \"$line\""
        fi
    done <<< "$LINESB"
}

COMPLETE () {
    # The lock and the traps go first, before the early return: -jl took the
    # lock like any other run and has to give it back.
    release_lock
    trap - INT TERM HUP
    if [[ -n $exitflag ]]; then
	    return 0
    fi
    if [[ $rm_list == True ]]; then
        rm -f "$listfile"
    fi
    # -ns: next run starts from the list this one started from, rather than
    # from what it just picked.
    if [[ $suspend_old == True ]] && [[ -e $oldfile ]]; then
        mv "$oldfile" "$listfile"
    fi
}


function chkrmd () {
    if [[ -d $1 ]]; then
        rm -rf "${1:?}/"
    fi
}

function chkrmf () {
    if [[ -e $1 ]] && [[ ! -z $(ls $1) ]]; then
        rm "$1"
    fi
}

UNRAR_FUN () {
    pdir="$1"
    ext='*.rar'
    cdir=$(find "$pdir" -name "$ext" -exec dirname {} + | sort -u)
    if [[ -z $cdir ]]; then
        return 0
    fi
    while read -r line; do
        cd "$line" && \
        unrar e -n -r -or "$line" && sleep 1 && \
        find "$line" -type f \( -regex ".*.rar$" -o -regex '.*.r[0-9]+$' \) -exec rm {} +
        find "$line" -type f \( -name "*.sfv" -o -name "*.nfo" \) -exec rm {} +
        find "$line" -type d -iname "sample" -exec rm -rf {} +
        find "$line" -type d -iname "screens" -exec rm -rf {} +
        find "$line" -type d -empty -delete

    done <<< "$cdir"
}

